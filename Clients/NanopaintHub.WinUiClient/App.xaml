<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NanopaintHub_WinUIClient.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NanopaintHub_WinUIClient.Converters"
    xmlns:local="using:NanopaintHub_WinUIClient"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:StringToColorConverter x:Key="StringToColorConverter" />
            <converters:StringToSolidColorBrushConverter x:Key="StringToSolidColorBrushConverter" />
            <converters:StringEqualityToVisibilityConverter x:Key="StringEqualityToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
