<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NanopaintHub_WinUIClient.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:NanopaintHub_WinUIClient.Converters"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <StackPanel Spacing="16">
                <!-- Group Header 1 -->
                <TextBlock Text="Motores de Geração (PDF Engine)" Style="{StaticResource SubtitleTextBlockStyle}" />
                
                <settings:SettingsCard Header="Motor para TDS (Ficha Técnica)" Description="Define qual biblioteca renderiza nativamente as fichas técnicas">
                    <settings:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9F9;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </settings:SettingsCard.HeaderIcon>
                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableEngines}" SelectedItem="{x:Bind ViewModel.TdsEngine, Mode=TwoWay}" Width="200" />
                </settings:SettingsCard>
                
                <settings:SettingsCard Header="Motor para SDS (Ficha de Segurança)" Description="Define a biblioteca usada para renderizar fichas de segurança">
                    <settings:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8D1;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </settings:SettingsCard.HeaderIcon>
                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableEngines}" SelectedItem="{x:Bind ViewModel.SdsEngine, Mode=TwoWay}" Width="200" />
                </settings:SettingsCard>
                
                <settings:SettingsCard Header="Base de Dados ECHA (REACH &amp; CLP)" Description="Importe o ficheiro CSV (Anexo VI do CLP) transferido do site da ECHA CHEM para atualizar propriedades GHS.">
                    <settings:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE81C;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </settings:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ImportStatusMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="Importar CSV da ECHA" Command="{x:Bind ViewModel.ImportEchaCsvCommand}" />
                    </StackPanel>
                </settings:SettingsCard>

                <!-- Group Header 2 -->
                <TextBlock Text="Diagnóstico e Alertas" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />

                <settings:SettingsCard Header="Configurações do Alerta REACH/CLP" Description="Ajuste de quanto em quanto tempo o sistema alerta sobre ficheiros desatualizados.">
                    <settings:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEA8F;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </settings:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <NumberBox Header="Aparece após (Meses)" Value="{x:Bind ViewModel.AlertThresholdMonths, Mode=TwoWay}" Minimum="1" Maximum="60" Width="150" SpinButtonPlacementMode="Compact" />
                        <NumberBox Header="Duração (Segundos)" Value="{x:Bind ViewModel.AlertDurationSeconds, Mode=TwoWay}" Minimum="0" Maximum="120" Width="150" SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                </settings:SettingsCard>

                <settings:SettingsCard Header="Diagnóstico e Inspeção de Base de Dados" Description="Monitorize o volume de dados do sistema e exporte a base de dados para análise profunda externa.">
                    <settings:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE733;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </settings:SettingsCard.HeaderIcon>
                    
                    <StackPanel Orientation="Horizontal" Spacing="32" HorizontalAlignment="Right">
                        <Grid RowSpacing="8" ColumnSpacing="16" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Fórmulas e Matérias:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TotalProducts, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Fornecedores:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TotalSuppliers, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Substâncias REACH:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TotalEchaSubstances, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Componentes:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TotalCompositions, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                        
                        <StackPanel VerticalAlignment="Center" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.ExportDatabaseCommand}" Style="{ThemeResource AccentButtonStyle}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                            <TextBlock Text="Exportar (.db / .json)" />
                                        </StackPanel>
                                    </Button.Content>
                                </Button>

                                <Button Command="{x:Bind ViewModel.ImportDatabaseCommand}" Style="{ThemeResource DefaultButtonStyle}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8B6;" FontSize="14" />
                                            <TextBlock Text="Importar (.db / .json)" />
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.DbStatusMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" />

                            <HyperlinkButton Content="{x:Bind ViewModel.ExportedFilePath, Mode=OneWay}"
                                             Command="{x:Bind ViewModel.OpenExportedDatabaseCommand}"
                                             Visibility="{x:Bind ViewModel.HasExportedFile, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                             ToolTipService.ToolTip="Abrir pasta do ficheiro exportado"
                                             FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </settings:SettingsCard>

            </StackPanel>

            <InfoBar IsOpen="True" Severity="Informational" Title="Multi-Engine Architecture" 
                     Message="A sua escolha entra em vigor imediatamente para as próximas gerações. Pode usar QuestPDF para elevada performance." />
        </StackPanel>
    </Grid>
</Page>
