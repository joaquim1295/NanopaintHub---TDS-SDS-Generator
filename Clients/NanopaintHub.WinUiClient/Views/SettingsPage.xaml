<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NanopaintHub_WinUIClient.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:NanopaintHub_WinUIClient.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="24">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Stretch">
            <TextBlock Text="Configurações" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />
            
            <StackPanel Spacing="16">
                <!-- Group Header -->
                <TextBlock Text="Motores de Geração (PDF Engine)" Style="{StaticResource SubtitleTextBlockStyle}" />
                
                <!-- Card 1: TDS Engine -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <FontIcon Grid.Column="0" Glyph="&#xE9F9;" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Motor para TDS (Ficha Técnica)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Define qual biblioteca renderiza nativamente as fichas técnicas" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        
                        <ComboBox Grid.Column="2" 
                                  ItemsSource="{x:Bind ViewModel.AvailableEngines}" 
                                  SelectedItem="{x:Bind ViewModel.TdsEngine, Mode=TwoWay}"
                                  Width="200" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                
                <!-- Card 2: SDS Engine -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <FontIcon Grid.Column="0" Glyph="&#xE8D1;" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Motor para SDS (Ficha de Segurança)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Define a biblioteca usada para renderizar fichas de segurança" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        
                        <ComboBox Grid.Column="2" 
                                  ItemsSource="{x:Bind ViewModel.AvailableEngines}" 
                                  SelectedItem="{x:Bind ViewModel.SdsEngine, Mode=TwoWay}"
                                  Width="200" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <!-- Card 3: ECHA Database -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <FontIcon Grid.Column="0" Glyph="&#xE81C;" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Base de Dados ECHA (REACH &amp; CLP)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Importe o ficheiro CSV (Anexo VI do CLP) transferido do site da ECHA CHEM para atualizar as frases de perigo e propriedades GHS das Fichas de Segurança." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="{x:Bind ViewModel.ImportStatusMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        
                        <Button Grid.Column="2" 
                                Content="Importar CSV da ECHA" 
                                Command="{x:Bind ViewModel.ImportEchaCsvCommand}"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Card 4: Notification Settings -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <FontIcon Grid.Column="0" Glyph="&#xEA8F;" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Configurações do Alerta REACH/CLP" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Ajuste de quanto em quanto tempo e durante quanto tempo o sistema alerta sobre ficheiros desatualizados." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,16,0">
                            <TextBlock Text="Aparece após (Meses)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <NumberBox Value="{x:Bind ViewModel.AlertThresholdMonths, Mode=TwoWay}" Minimum="1" Maximum="60" Width="120" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        
                        <StackPanel Grid.Column="3" Orientation="Vertical">
                            <TextBlock Text="Duração (Segundos)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <NumberBox Value="{x:Bind ViewModel.AlertDurationSeconds, Mode=TwoWay}" Minimum="0" Maximum="120" Width="120" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 5: Database Diagnostics & Inspector -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <FontIcon Grid.Column="0" Glyph="&#xE733;" FontSize="20" VerticalAlignment="Top" Margin="0,4,16,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,0,16,0">
                            <TextBlock Text="Diagnóstico e Inspeção de Base de Dados" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Monitorize o volume de dados do sistema e exporte a base de dados para análise profunda externa." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            
                            <Grid RowSpacing="8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Fórmulas e Matérias:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.TotalProducts, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                                
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Fornecedores:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.TotalSuppliers, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                                
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Substâncias REACH/ECHA:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.TotalEchaSubstances, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Componentes Químicos:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.TotalCompositions, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                            <Button Command="{x:Bind ViewModel.ExportDatabaseCommand}"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                        <TextBlock Text="Exportar Dados (.db / .json)" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <HyperlinkButton Content="{x:Bind ViewModel.ExportedFilePath, Mode=OneWay}"
                                             Command="{x:Bind ViewModel.OpenExportedDatabaseCommand}"
                                             Visibility="{x:Bind ViewModel.HasExportedFile, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                             ToolTipService.ToolTip="Abrir pasta do ficheiro exportado"
                                             FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <InfoBar IsOpen="True" Severity="Informational" Title="Multi-Engine Architecture" 
                     Message="A sua escolha entra em vigor imediatamente para as próximas gerações. Pode usar QuestPDF para elevada performance." />
        </StackPanel>
    </Grid>
</Page>
