<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NanopaintHub_WinUIClient.Views.ProductEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:NanopaintHub_WinUIClient.ViewModels"
    xmlns:entities="using:NanopaintHub.Domain.Entities"
    xmlns:dtos="using:NanopaintHub.Application.DTOs"
    xmlns:converters="using:NanopaintHub_WinUIClient.Converters"
    xmlns:selectors="using:NanopaintHub_WinUIClient.Selectors"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:PercentageToBrushConverter x:Key="PercentageToBrushConverter" />
        
        <DataTemplate x:Key="SubstanceTemplate" x:DataType="viewmodels:CompositionViewModel">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DisplayDescription}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                    <TextBox Text="{Binding PercentageInput, Mode=TwoWay, UpdateSourceTrigger=Default}" 
                             Foreground="{Binding Percentage, Converter={StaticResource PercentageToBrushConverter}}"
                             PlaceholderText="0" Width="50" TextAlignment="Right" />
                    <TextBlock Text="%" VerticalAlignment="Center" />
                </StackPanel>
                
                <Button Grid.Column="2" Content="Remover" VerticalAlignment="Center"
                        Command="{Binding ElementName=RootGrid, Path=DataContext.RemoveCompositionCommand}" 
                        CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SupplierProductTemplate" x:DataType="viewmodels:CompositionViewModel">
            <Border Margin="0,0,0,8" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Background="Transparent" BorderThickness="0">
                    <Expander.Header>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DisplayDescription}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBox Text="{Binding PercentageInput, Mode=TwoWay, UpdateSourceTrigger=Default}" 
                                         Foreground="{Binding Percentage, Converter={StaticResource PercentageToBrushConverter}}"
                                         PlaceholderText="0" Width="50" TextAlignment="Right" />
                                <TextBlock Text="%" VerticalAlignment="Center" />
                                <Button Content="Remover" VerticalAlignment="Center" Margin="8,0,0,0"
                                        Command="{Binding ElementName=RootGrid, Path=DataContext.RemoveCompositionCommand}" 
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel Spacing="8" Padding="12,8,12,16">
                            <TextBlock Text="Composição Interna (Lida do PDF):" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding InnerComponents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:InnerComponentViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="•" Margin="0,0,8,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ChemicalName}" TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="{Binding EffectivePercentage}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="%" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander.Content>
                </Expander>
            </Border>
        </DataTemplate>

        <selectors:CompositionTemplateSelector x:Key="CompositionTemplateSelector"
             SubstanceTemplate="{StaticResource SubstanceTemplate}"
             SupplierProductTemplate="{StaticResource SupplierProductTemplate}" />
    </Page.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*" Padding="0">
        <!-- HEADER (Regra 5: CommandBar Superior) -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{x:Bind ViewModel.CancelCommand}" Background="Transparent" BorderThickness="0" Padding="8" Margin="0,0,16,0" ToolTipService.ToolTip="Voltar" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
            </Button>
            
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" Margin="0" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="Cancelar" Command="{x:Bind ViewModel.CancelCommand}" Style="{ThemeResource DefaultButtonStyle}" />
                <Button Content="Salvar Produto" Command="{x:Bind ViewModel.SaveCommand}" Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- MAIN LAYOUT (Abas | Formulário | Splitter | Live Preview) -->
        <Grid Grid.Row="1">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" Width="64" Height="64" />
            
            <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='negate'}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Coluna 0: Sidebar Navegação -->
                    <ColumnDefinition Width="2*" MinWidth="450" />    <!-- Coluna 1: Conteúdo/Editor -->
                    <ColumnDefinition Width="Auto" /> <!-- Coluna 2: Grid Splitter -->
                    <ColumnDefinition Width="3*" x:Name="PreviewColumn" MinWidth="350" />   <!-- Coluna 3: Live Preview -->
                    <ColumnDefinition Width="Auto" /> <!-- Coluna 4: Preview Sidebar -->
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR (Etiquetas Coladas) -->
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Top" Margin="0,16,-1,0" Canvas.ZIndex="1" HorizontalAlignment="Right">
                    <ToggleButton x:Name="TagGeneral" IsChecked="True" ToolTipService.ToolTip="Geral e Características" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE946;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TagProperties" ToolTipService.ToolTip="Propriedades Físicas" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xED5E;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TagSafety" ToolTipService.ToolTip="Fórmula e Segurança" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE81C;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TagSensor" ToolTipService.ToolTip="Especificações do Sensor" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE9A6;" />
                    </ToggleButton>
                </StackPanel>

                <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Canvas.ZIndex="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel Spacing="12" MaxWidth="1200" HorizontalAlignment="Stretch">
                            
                            <!-- SEÇÃO GERAL E CARACTERÍSTICAS -->
                            <StackPanel x:Name="GeneralSection" Spacing="12" Visibility="Visible">
                                <settings:SettingsExpander Header="Informação Geral" Description="Identificação básica do produto" IsExpanded="True">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE946;" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard Header="Nome do Produto">
                                            <TextBox Text="{x:Bind ViewModel.Product.Name, Mode=TwoWay}" Width="350" TextChanged="AutoTriggerPreview_TextChanged" />
                                        </settings:SettingsCard>
                                        
                                        <settings:SettingsCard Header="Código do Produto">
                                            <TextBox Text="{x:Bind ViewModel.Product.Code, Mode=TwoWay}" Width="350" TextChanged="AutoTriggerPreview_TextChanged" />
                                        </settings:SettingsCard>
                                        
                                        <settings:SettingsCard Header="Descrição" Description="Descrição geral do produto">
                                            <settings:SettingsCard.HeaderIcon>
                                                <FontIcon Glyph="&#xE8C1;" />
                                            </settings:SettingsCard.HeaderIcon>
                                            <Button Content="Editar Descrição" Click="OpenDescriptionDialog_Click">
                                                <Button.ContentTransitions>
                                                    <TransitionCollection />
                                                </Button.ContentTransitions>
                                            </Button>
                                        </settings:SettingsCard>

                                        <settings:SettingsCard Header="Imagem do Produto" Description="Foto ou renderização exibida no cabeçalho do TDS">
                                            <settings:SettingsCard.HeaderIcon>
                                                <FontIcon Glyph="&#xEB9F;" />
                                            </settings:SettingsCard.HeaderIcon>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Content="Selecionar Imagem..." Command="{x:Bind ViewModel.SelectProductImageCommand}" Style="{ThemeResource DefaultButtonStyle}" />
                                                <Button Content="Remover" Command="{x:Bind ViewModel.RemoveProductImageCommand}" 
                                                        Visibility="{x:Bind ViewModel.HasProductImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </StackPanel>
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>

                                <settings:SettingsExpander Header="Características (Ink Features)" Description="Propriedades visuais e operacionais" IsExpanded="True">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE81E;" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" Padding="12,8">
                                            <StackPanel Spacing="16" Margin="0,4">
                                                <!-- Linha de Ações: Título e Botão de Adicionar -->
                                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                    <TextBlock Text="Características" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Adicionar Característica" Command="{x:Bind ViewModel.AddFeatureCommand}" Style="{ThemeResource DefaultButtonStyle}"/>
                                                </Grid>
                                                
                                                <!-- Lista Dinâmica de Características -->
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.Features}"
                                                              Visibility="{x:Bind ViewModel.HasFeatures, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewmodels:StringItem">
                                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                                <TextBox Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ex: RoHS compliant" TextChanged="AutoTriggerPreview_TextChanged" />
                                                                <Button Grid.Column="1" Margin="8,0,0,0" Content="Remover" 
                                                                        Command="{Binding ElementName=RootGrid, Path=DataContext.RemoveFeatureCommand}" 
                                                                        CommandParameter="{x:Bind}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                            </StackPanel>

                            <!-- SEÇÃO PROPRIEDADES FÍSICAS -->
                            <StackPanel x:Name="PropertiesSection" Spacing="12" Visibility="Collapsed">
                                <settings:SettingsExpander Header="Liquid Properties" Description="Propriedades físicas da tinta líquida" IsExpanded="True">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xED5E;" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" Padding="12,8">
                                            <StackPanel Spacing="16" Margin="0,4">
                                                <!-- Linha de Ações: Título e Botão de Adicionar -->
                                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                    <TextBlock Text="Propriedades Líquidas" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Adicionar Propriedade" Command="{x:Bind ViewModel.AddLiquidPropertyCommand}" Style="{ThemeResource DefaultButtonStyle}"/>
                                                </Grid>
                                                
                                                <!-- Lista Dinâmica de Propriedades -->
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.LiquidProperties}"
                                                              Visibility="{x:Bind ViewModel.HasLiquidProperties, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewmodels:KeyValuePairItem">
                                                            <Grid ColumnDefinitions="*,*,Auto" Margin="0,4">
                                                                <TextBox Grid.Column="0" Text="{x:Bind Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Propriedade (ex: Viscosity)" Margin="0,0,8,0" TextChanged="AutoTriggerPreview_TextChanged" />
                                                                <TextBox Grid.Column="1" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Valor (ex: 25–35 Pa·s)" TextChanged="AutoTriggerPreview_TextChanged" />
                                                                <Button Grid.Column="2" Margin="8,0,0,0" Content="Remover" 
                                                                        Command="{Binding ElementName=RootGrid, Path=DataContext.RemoveLiquidPropertyCommand}" 
                                                                        CommandParameter="{x:Bind}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>

                                <settings:SettingsExpander Header="Handling Guidelines" Description="Mechanical Properties e cura" IsExpanded="True">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE90F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" Padding="12,8">
                                            <StackPanel Spacing="16" Margin="0,4">
                                                <!-- Linha de Ações: Título e Botão de Adicionar -->
                                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                    <TextBlock Text="Diretrizes de Manuseamento" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Adicionar Guideline" Command="{x:Bind ViewModel.AddMechanicalPropertyCommand}" Style="{ThemeResource DefaultButtonStyle}"/>
                                                </Grid>
                                                
                                                <!-- Lista Dinâmica de Guidelines -->
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.MechanicalProperties}"
                                                              Visibility="{x:Bind ViewModel.HasMechanicalProperties, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewmodels:KeyValuePairItem">
                                                            <Grid ColumnDefinitions="*,*,Auto" Margin="0,4">
                                                                <TextBox Grid.Column="0" Text="{x:Bind Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Propriedade (ex: Curing)" Margin="0,0,8,0" TextChanged="AutoTriggerPreview_TextChanged" />
                                                                <TextBox Grid.Column="1" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Valor (ex: 120 °C / 15 min)" TextChanged="AutoTriggerPreview_TextChanged" />
                                                                <Button Grid.Column="2" Margin="8,0,0,0" Content="Remover" 
                                                                        Command="{Binding ElementName=RootGrid, Path=DataContext.RemoveMechanicalPropertyCommand}" 
                                                                        CommandParameter="{x:Bind}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                            </StackPanel>

                            <StackPanel x:Name="SafetySection" Spacing="12" Visibility="Collapsed">
                                <settings:SettingsExpander Header="Fórmula (Componentes SDS)" Description="Ingredientes e substâncias ECHA" IsExpanded="True">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE81C;" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" Padding="12,8">
                                            <StackPanel Spacing="16" Margin="0,4">
                                                <!-- Linha de Ações: Pesquisa -->
                                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                    <TextBlock Text="Ingredientes da Fórmula" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="SubstanceSearchBox" Grid.Column="1" 
                                                             PlaceholderText="Pesquisar por nome ECHA (mín. 3 letras)" 
                                                             Width="250"
                                                             TextChanged="SubstanceSearchBox_TextChanged" VerticalAlignment="Center"/>
                                                </Grid>
                                                
                                                <!-- Popup de Resultados -->
                                                <Border x:Name="SubstanceSearchResultsPopup" 
                                                        Visibility="Collapsed"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                        CornerRadius="4" Margin="0,4,0,0" MaxHeight="200">
                                                    <ListView ItemsSource="{x:Bind ViewModel.SubstanceSearchResults, Mode=OneWay}"
                                                              ItemClick="SubstanceSearchResults_ItemClick" IsItemClickEnabled="True" SelectionMode="None">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="dtos:FederatedSearchResult">
                                                                <StackPanel Padding="0,4">
                                                                    <TextBlock Text="{Binding DisplayName}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                                    <TextBlock Text="{Binding Description}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </Border>
                                                
                                                <!-- For compatibility with page-behind event handlers -->
                                                <TextBox x:Name="SubstanceSearchBoxWide" Visibility="Collapsed" />
                                                <Border x:Name="SubstanceSearchResultsPopupWide" Visibility="Collapsed" />
                                                
                                                <!-- InfoBar -->
                                                <InfoBar IsOpen="{x:Bind ViewModel.HasCompositionsError, Mode=OneWay}"
                                                         Severity="Error"
                                                         Message="{x:Bind ViewModel.CompositionsValidationMessage, Mode=OneWay}" 
                                                         IsClosable="False" Margin="0,0,0,0" />
                                                
                                                <!-- Lista de Ingredientes da Fórmula -->
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.Compositions}"
                                                              ItemTemplateSelector="{StaticResource CompositionTemplateSelector}">
                                                </ItemsControl>
                                            </StackPanel>
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>

                                <settings:SettingsExpander Header="Anexos REACH" Description="Concatenar Cenários de Exposição" IsExpanded="True">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard Header="Caminho do PDF Cenário de Exposição">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <TextBox Text="{x:Bind ViewModel.Product.ExposureScenarioPdfPath, Mode=TwoWay}" Width="250" TextChanged="AutoTriggerPreview_TextChanged" />
                                                <Button Content="Procurar PDF" Command="{x:Bind ViewModel.SelectPdfCommand}" />
                                            </StackPanel>
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                            </StackPanel>

                            <!-- SEÇÃO SENSOR -->
                            <StackPanel x:Name="SensorSection" Spacing="12" Visibility="Collapsed">
                                <settings:SettingsExpander Header="Especificações do Sensor" Description="Parâmetros de performance e especificações dinâmicas" IsExpanded="True">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE9A6;" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard Header="Incluir Especificações do Sensor no TDS">
                                            <ToggleSwitch IsOn="{x:Bind ViewModel.SensorSpecs.IsEnabled, Mode=TwoWay}" Toggled="AutoTriggerPreview_Toggled" />
                                        </settings:SettingsCard>

                                        <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" Padding="12,8" IsEnabled="{x:Bind ViewModel.SensorSpecs.IsEnabled, Mode=OneWay}">
                                            <StackPanel Spacing="16" Margin="0,4">
                                                <!-- Linha de Ações: Título e Botão de Adicionar -->
                                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                    <TextBlock Text="Parâmetros" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Adicionar Especificação" Command="{x:Bind ViewModel.AddCustomSensorSpecCommand}" Style="{ThemeResource DefaultButtonStyle}"/>
                                                </Grid>
                                                
                                                <!-- Lista Dinâmica de Especificações customizadas -->
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.CustomSensorSpecs}"
                                                              Visibility="{x:Bind ViewModel.HasCustomSensorSpecs, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewmodels:KeyValuePairItem">
                                                            <Grid ColumnDefinitions="*,*,Auto" Margin="0,4">
                                                                <TextBox Grid.Column="0" Text="{x:Bind Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Espec. Adicional" Margin="0,0,8,0" TextChanged="AutoTriggerPreview_TextChanged" />
                                                                <TextBox Grid.Column="1" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Valor" TextChanged="AutoTriggerPreview_TextChanged" />
                                                                <Button Grid.Column="2" Margin="8,0,0,0" Content="Remover" 
                                                                        Command="{Binding ElementName=RootGrid, Path=DataContext.RemoveCustomSensorSpecCommand}" 
                                                                        CommandParameter="{x:Bind}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                
                                                <!-- Grelha Densa de Parâmetros Padrão -->
                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                                                    <TextBox Grid.Row="0" Grid.Column="0" Header="Unidade de Força" Text="{x:Bind ViewModel.SensorSpecs.ForceUnit, Mode=TwoWay}" TextChanged="AutoTriggerPreview_TextChanged" />
                                                    <TextBox Grid.Row="0" Grid.Column="1" Header="Sensibilidade (Volts)" Text="{Binding SensorSpecs.SensitivityVolts, Mode=TwoWay, TargetNullValue=''}" TextChanged="AutoTriggerPreview_TextChanged" />
                                                    <TextBox Grid.Row="1" Grid.Column="0" Header="Sensibilidade / Unid." Text="{Binding SensorSpecs.SensitivityPerUnit, Mode=TwoWay, TargetNullValue=''}" TextChanged="AutoTriggerPreview_TextChanged" />
                                                    <TextBox Grid.Row="1" Grid.Column="1" Header="Tempo Resposta (s)" Text="{Binding SensorSpecs.ResponseTimeSec, Mode=TwoWay, TargetNullValue=''}" TextChanged="AutoTriggerPreview_TextChanged" />
                                                    <TextBox Grid.Row="2" Grid.Column="0" Header="Recuperação (s)" Text="{Binding SensorSpecs.RecoveryTimeSec, Mode=TwoWay, TargetNullValue=''}" TextChanged="AutoTriggerPreview_TextChanged" />
                                                    <TextBox Grid.Row="2" Grid.Column="1" Header="Repetibilidade (%)" Text="{Binding SensorSpecs.RepeatabilityPercent, Mode=TwoWay, TargetNullValue=''}" TextChanged="AutoTriggerPreview_TextChanged" />
                                                    <TextBox Grid.Row="3" Grid.Column="0" Header="Resist. Repouso (Ohms)" Text="{Binding SensorSpecs.RestResistanceOhms, Mode=TwoWay, TargetNullValue=''}" TextChanged="AutoTriggerPreview_TextChanged" />
                                                    <TextBox Grid.Row="3" Grid.Column="1" Header="Histerese (%)" Text="{Binding SensorSpecs.HysteresisPercent, Mode=TwoWay, TargetNullValue=''}" TextChanged="AutoTriggerPreview_TextChanged" />
                                                    <TextBox Grid.Row="4" Grid.Column="0" Header="Temp Op Min (°C)" Text="{Binding SensorSpecs.OperatingTempMinC, Mode=TwoWay, TargetNullValue=''}" TextChanged="AutoTriggerPreview_TextChanged" />
                                                    <TextBox Grid.Row="4" Grid.Column="1" Header="Temp Op Max (°C)" Text="{Binding SensorSpecs.OperatingTempMaxC, Mode=TwoWay, TargetNullValue=''}" TextChanged="AutoTriggerPreview_TextChanged" />
                                                    <TextBox Grid.Row="5" Grid.Column="0" Header="Range Min" Text="{Binding SensorSpecs.RangeMin, Mode=TwoWay, TargetNullValue=''}" TextChanged="AutoTriggerPreview_TextChanged" />
                                                    <TextBox Grid.Row="5" Grid.Column="1" Header="Range Max" Text="{Binding SensorSpecs.RangeMax, Mode=TwoWay, TargetNullValue=''}" TextChanged="AutoTriggerPreview_TextChanged" />
                                                </Grid>
                                            </StackPanel>
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>

                                <settings:SettingsExpander Header="Gráficos de Desempenho (Performance Charts)" Description="Importar dados de laboratório (.csv/.xls) ou imagens para os gráficos do TDS" IsExpanded="True">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE9D2;" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard Header="Gráfico 1: Linearidade (Força vs Saída)" Description="{x:Bind ViewModel.LinearityChartStatus, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Importar CSV/Dados" Click="ImportLinearityCsv_Click" Style="{ThemeResource DefaultButtonStyle}" />
                                                <Button Content="Importar Imagem" Click="ImportLinearityImage_Click" />
                                                <Button Content="Limpar" Click="ClearLinearity_Click" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </StackPanel>
                                        </settings:SettingsCard>

                                        <settings:SettingsCard Header="Gráfico 2: Resistência vs Força" Description="{x:Bind ViewModel.ResistanceChartStatus, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Importar CSV/Dados" Click="ImportResistanceCsv_Click" Style="{ThemeResource DefaultButtonStyle}" />
                                                <Button Content="Importar Imagem" Click="ImportResistanceImage_Click" />
                                                <Button Content="Limpar" Click="ClearResistance_Click" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </StackPanel>
                                        </settings:SettingsCard>

                                        <settings:SettingsCard Header="Gráfico 3: Histerese (Carga e Descarga)" Description="{x:Bind ViewModel.HysteresisChartStatus, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Importar CSV/Dados" Click="ImportHysteresisCsv_Click" Style="{ThemeResource DefaultButtonStyle}" />
                                                <Button Content="Importar Imagem" Click="ImportHysteresisImage_Click" />
                                                <Button Content="Limpar" Click="ClearHysteresis_Click" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </StackPanel>
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- GRID SPLITTER (Coluna 2) -->
                <sizers:GridSplitter x:Name="PreviewSplitter" Grid.Column="2" Width="16" Background="Transparent" ResizeBehavior="BasedOnAlignment" ResizeDirection="Columns" />

                <!-- LIVE PREVIEW ANTI-FLICKERING (Coluna 3) -->
                <Grid x:Name="PreviewContainer" Grid.Column="3" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Overlay Header -->
                    <Grid Grid.Row="0" Padding="16,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Pré-visualização do Documento" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />

                        <ToggleButton Grid.Column="1" x:Name="TogglePreviewControlsButton" IsChecked="False" Padding="8,4" Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" ToolTipService.ToolTip="Opções de Tipo e Template">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE713;" FontSize="12" />
                                <TextBlock Text="Opções" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                    
                    <!-- Controles de Preview (Colapsável) -->
                    <Grid Grid.Row="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                          Visibility="{x:Bind TogglePreviewControlsButton.IsChecked, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Doc Type selector -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Tipo de Documento" Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{x:Bind ViewModel.SelectedDocType, Mode=TwoWay}" SelectedValuePath="Content" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="TDS" />
                                <ComboBoxItem Content="SDS" />
                            </ComboBox>
                        </StackPanel>
                        
                        <!-- Template selector -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Template Visual" Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.AvailableTemplates, Mode=OneWay}" 
                                      SelectedItem="{x:Bind ViewModel.SelectedTemplate, Mode=TwoWay}" 
                                      DisplayMemberPath="TemplateName"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Padrão (Memória)" />
                        </StackPanel>
                    </Grid>
                    
                    <Grid Grid.Row="2">
                        <!-- Content Base -->
                        <ScrollViewer x:Name="PreviewScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PdfPreviewImages, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding}" MaxWidth="1000" Stretch="Uniform" Margin="0,8,0,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        
                        <!-- Anti-Flickering Overlay -->
                        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.7" Canvas.ZIndex="50" Visibility="{x:Bind ViewModel.IsLoadingPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingPreview, Mode=OneWay}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- PREVIEW SIDEBAR (Coluna 4: Etiqueta Colada) -->
                <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Top" Margin="-1,16,0,0" Canvas.ZIndex="1" HorizontalAlignment="Left">
                    <ToggleButton x:Name="TogglePreviewBtn" IsChecked="True" ToolTipService.ToolTip="Mostrar Pré-visualização" Checked="TogglePreview_Changed" Unchecked="TogglePreview_Changed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,1,1" CornerRadius="0,8,8,0" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE8A1;" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Grid>
        <!-- Diálogo para Edição de Descrição do Produto -->
        <ContentDialog x:Name="DescriptionDialog"
                       Title="Editar Descrição do Produto"
                       PrimaryButtonText="Gravar e Fechar"
                       CloseButtonText="Cancelar"
                       DefaultButton="Primary"
                       CornerRadius="8">
            <Grid Width="500" Margin="0,8,0,0">
                <TextBox x:Name="DescriptionTextBox" 
                         AcceptsReturn="True" TextWrapping="Wrap" 
                         MinHeight="150" MaxHeight="400" 
                         HorizontalAlignment="Stretch" 
                         PlaceholderText="Digite a descrição geral do produto..." />
            </Grid>
        </ContentDialog>
    </Grid>
</Page>
