<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NanopaintHub_WinUIClient.Views.GeneratePdfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:entities="using:NanopaintHub.Domain.Entities"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Gerador de PDF" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,24" />

        <!-- Form -->
        <StackPanel Grid.Row="1" Spacing="24" MaxWidth="600" HorizontalAlignment="Left">
            
            <!-- Type Selection -->
            <StackPanel Spacing="8">
                <TextBlock Text="Tipo de Documento" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ComboBox SelectedValue="{x:Bind ViewModel.DocumentType, Mode=TwoWay}" SelectedValuePath="Content" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="TDS" />
                    <ComboBoxItem Content="SDS" />
                </ComboBox>
            </StackPanel>

            <!-- Product Selection -->
            <StackPanel Spacing="8">
                <TextBlock Text="Produto" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ComboBox ItemsSource="{x:Bind ViewModel.Products, Mode=OneWay}" 
                          SelectedItem="{x:Bind ViewModel.SelectedProduct, Mode=TwoWay}" 
                          DisplayMemberPath="Name" 
                          HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- Template Selection -->
            <StackPanel Spacing="8">
                <TextBlock Text="Template" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ComboBox ItemsSource="{x:Bind ViewModel.Templates, Mode=OneWay}" 
                          SelectedItem="{x:Bind ViewModel.SelectedTemplate, Mode=TwoWay}" 
                          DisplayMemberPath="TemplateName" 
                          HorizontalAlignment="Stretch" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Gerar e Salvar PDF" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.GeneratePdfCommand}" />
                <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" 
                              Margin="16,0,0,0" HorizontalAlignment="Right" />
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />

        </StackPanel>
    </Grid>
</Page>
