<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NanopaintHub_WinUIClient.Views.GeneratePdfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:entities="using:NanopaintHub.Domain.Entities"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:media="using:Microsoft.UI.Xaml.Media.Imaging"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24" VerticalAlignment="Center">
            <Button Command="{x:Bind ViewModel.GoBackCommand}" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Voltar">
                <FontIcon Glyph="&#xE72B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
            </Button>
            <TextBlock Text="Gerador de PDF" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" Margin="0" />
        </StackPanel>

        <!-- Form Content -->
        <Grid Grid.Row="1" ColumnSpacing="24">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Spacing="24" MaxWidth="640" HorizontalAlignment="Left">
            
            <!-- Card: Seleção de Documento -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="20">
                    <TextBlock Text="Dados do Documento" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Type Selection -->
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="Tipo" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.DocumentTypes}" SelectedItem="{x:Bind ViewModel.DocumentType, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Product Selection -->
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="Produto" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Products, Mode=OneWay}" 
                                      SelectedItem="{x:Bind ViewModel.SelectedProduct, Mode=TwoWay}" 
                                      DisplayMemberPath="Name" 
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <!-- Template Selection -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Modelo de Impressão (Template)" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.FilteredTemplates, Mode=OneWay}" 
                                  SelectedItem="{x:Bind ViewModel.SelectedTemplate, Mode=TwoWay}" 
                                  DisplayMemberPath="TemplateName" 
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card: Configurações Finais -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="20">
                    <TextBlock Text="Configurações de Impressão" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="Tamanho da Página" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.PageFormats}" SelectedItem="{x:Bind ViewModel.PageFormat, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="Orientação" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.PageOrientations}" SelectedItem="{x:Bind ViewModel.PageOrientation, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Actions Bar -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Margin="0,0,16,0" Command="{x:Bind ViewModel.PreviewPdfImageCommand}" Height="40">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7C5;" FontSize="16"/>
                                <TextBlock Text="Pré‑Visualizar PDF" Margin="0,0,4,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <Button Grid.Column="1" Margin="0,0,16,0" Command="{x:Bind ViewModel.EditContentWithTinyMceCommand}" IsEnabled="{x:Bind ViewModel.IsNotQuestPdfSelected, Mode=OneWay}" Height="40">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE70F;" FontSize="16"/>
                                <TextBlock Text="Ajustar Conteúdo" Margin="0,0,4,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                
                <Button Grid.Column="2" Content="Gerar e Salvar PDF" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.GeneratePdfCommand}" Height="40" Padding="24,0"/>
                
                <ProgressRing Grid.Column="3" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" 
                              Margin="16,0,0,0" HorizontalAlignment="Left" Width="24" Height="24" />
            </Grid>

            <!-- QuestPDF Warning Message -->
            <controls:InfoBar IsOpen="{x:Bind ViewModel.IsQuestPdfSelected, Mode=OneWay}" 
                              Severity="Informational" 
                              Title="Edição indisponível" 
                              Message="O motor QuestPDF não permite ajustes manuais. Para edição avançada, altere os dados do Produto, utilize o Template Builder, ou altere o motor de PDF nas Definições da aplicação."
                              IsClosable="False"
                              Margin="0,8,0,0" />

            <!-- Status Message -->
            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ViewModel.HasSavedFile, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Salvo em:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <HyperlinkButton Content="{x:Bind ViewModel.SavedFilePath, Mode=OneWay}" 
                                     Click="OpenPdf_Click" />
                </StackPanel>
            </StackPanel>
    </StackPanel>

    <!-- Preview Column -->
    <ScrollViewer Grid.Column="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{x:Bind ViewModel.PdfPreviewImages, Mode=OneWay}" 
                      Visibility="{x:Bind ViewModel.IsPdfPreviewVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding}" MaxWidth="800" Stretch="Uniform" Margin="0,8,0,8"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
    </Grid>
    </Grid>
</Page>
