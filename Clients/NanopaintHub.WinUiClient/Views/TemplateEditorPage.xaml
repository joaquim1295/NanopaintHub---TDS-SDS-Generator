                                                    <Flyout>
                                                        <StackPanel Spacing="8">
                                                            <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Footer.TextColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="AutoTriggerPreview_Changed" />
