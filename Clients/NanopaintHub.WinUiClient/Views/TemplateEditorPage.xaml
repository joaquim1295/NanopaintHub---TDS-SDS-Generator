                                    <FontIcon Glyph="&#xE790;" />
                                </settings:SettingsExpander.HeaderIcon>
                                <settings:SettingsExpander.Items>
                                    <settings:SettingsCard Header="Cor dos Títulos de Secção" Description="Cor dos títulos das secções do documento">
                                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                            <Button Grid.Column="0" Width="40" Height="40" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
                                                <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <StackPanel Spacing="8">
                                                            <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="AutoTriggerPreview_Changed" />
                                                            <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center" />
                                        </Grid>
                                    </settings:SettingsCard>

                                    <settings:SettingsCard Header="Cor do Texto do Conteúdo" Description="Cor do texto interno das secções">
