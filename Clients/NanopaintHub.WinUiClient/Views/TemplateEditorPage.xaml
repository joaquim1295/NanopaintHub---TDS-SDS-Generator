                                    </settings:SettingsCard>
                                    <settings:SettingsCard Header="Conteúdo -&gt; Rodapé">
                                        <NumberBox Value="{x:Bind ViewModel.BuilderModel.Layout.FooterPaddingTop, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="100" ValueChanged="AutoTriggerPreview_Changed" Width="120" />
