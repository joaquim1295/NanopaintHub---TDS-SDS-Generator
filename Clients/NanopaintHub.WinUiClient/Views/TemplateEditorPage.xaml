<Page
    x:Class="NanopaintHub_WinUIClient.Views.TemplateEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NanopaintHub_WinUIClient.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NanopaintHub_WinUIClient.Models"
    xmlns:viewModels="using:NanopaintHub_WinUIClient.ViewModels"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
    </Page.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*" Padding="0">
        <!-- HEADER (Regra 5: CommandBar Superior) -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{x:Bind ViewModel.CancelCommand}" Background="Transparent" BorderThickness="0" Padding="8" Margin="0,0,16,0" ToolTipService.ToolTip="Voltar" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
            </Button>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox Text="{x:Bind ViewModel.Template.TemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="20" FontWeight="SemiBold" 
                         Background="Transparent" BorderThickness="0" 
                         PlaceholderText="Nome do Template" MinWidth="200" MaxWidth="400" VerticalAlignment="Center" />
                <TextBlock Text="Tipo:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox SelectedValue="{x:Bind ViewModel.Template.DocumentType, Mode=TwoWay}" 
                          SelectedValuePath="Content" VerticalAlignment="Center" Width="100" SelectionChanged="DocumentType_SelectionChanged" >
                    <ComboBoxItem Content="TDS" />
                    <ComboBoxItem Content="SDS" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="Cancelar" Command="{x:Bind ViewModel.CancelCommand}" Style="{ThemeResource DefaultButtonStyle}" />
                <Button Content="Salvar Template" Command="{x:Bind ViewModel.SaveCommand}" Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- MAIN LAYOUT (Regra 1: Split-View [Auto] | [6*] | [Auto] | [4*]) -->
        <Grid Grid.Row="1">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" Width="64" Height="64" />
            
            <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='negate'}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Coluna 0: Sidebar Navegação -->
                    <ColumnDefinition Width="2*" />    <!-- Coluna 1: Conteúdo/Editor -->
                    <ColumnDefinition Width="Auto" /> <!-- Coluna 2: Grid Splitter -->
                    <ColumnDefinition Width="3*" x:Name="PreviewColumn" />   <!-- Coluna 3: Live Preview -->
                    <ColumnDefinition Width="Auto" /> <!-- Coluna 4: Preview Sidebar -->
                </Grid.ColumnDefinitions>
                
                <!-- SIDEBAR (Regra 2: Etiquetas Coladas) -->
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Top" Margin="0,16,-1,0" Canvas.ZIndex="1" HorizontalAlignment="Right">
                    <ToggleButton x:Name="TagTheme" IsChecked="True" ToolTipService.ToolTip="Tema Global" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE790;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TagHeader" ToolTipService.ToolTip="Cabeçalho" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE81E;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TagFooter" ToolTipService.ToolTip="Rodapé" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE81D;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TagBatch" ToolTipService.ToolTip="Lotes e Layout" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE8B9;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TagSections" ToolTipService.ToolTip="Secções e Design" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE8FD;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TagCode" ToolTipService.ToolTip="Modo Código Raw" Visibility="{x:Bind ViewModel.IsNotQuestPdfSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE943;" />
                    </ToggleButton>
                </StackPanel>
                
                <!-- EDITOR RESPONSIVO (Coluna 1) -->
                <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Canvas.ZIndex="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
                        <controls:InfoBar x:Name="QuestPdfInfoBar" IsOpen="{x:Bind ViewModel.IsQuestPdfSelected, Mode=OneWay}" 
                                      Severity="Informational" Title="QuestPDF Ativo" 
                                      Message="A edição livre está desativada." 
                                      IsClosable="True" />
                    </StackPanel>
                    
                    
                    <!-- Painel 1: Tema Global -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanelTheme" Visibility="Visible">
                        <ScrollViewer.ContentTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </ScrollViewer.ContentTransitions>
                        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch" Padding="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tema Global" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,8" Grid.Column="0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Button Command="{x:Bind ViewModel.UndoCommand}" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Desfazer alteração">
                                        <BitmapIcon UriSource="ms-appx:///Assets/icons8-undo-64.png" Width="20" Height="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ShowAsMonochrome="True" />
                                    </Button>
                                <Button Command="{x:Bind ViewModel.RedoCommand}" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Refazer alteração">
                                        <BitmapIcon UriSource="ms-appx:///Assets/icons8-redo-64.png" Width="20" Height="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ShowAsMonochrome="True" />
                                    </Button>
                            </StackPanel>
                            </Grid>
                            
                            <settings:SettingsCard Header="Cor Primária" Description="A cor de destaque do documento.">
                                <settings:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE790;" />
                                </settings:SettingsCard.HeaderIcon>
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <Button Grid.Column="0" Width="40" Height="40" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
                                        <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="8">
                                                    <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="AutoTriggerPreview_Changed" />
                                                    <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center" />
                                </Grid>
                            </settings:SettingsCard>
                            
                            <settings:SettingsCard Header="Cor Secundária" Description="A cor para títulos secundários.">
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <Button Grid.Column="0" Width="40" Height="40" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
                                        <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="8">
                                                    <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="AutoTriggerPreview_Changed" />
                                                    <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center" />
                                </Grid>
                            </settings:SettingsCard>

                            <settings:SettingsCard Header="Tipo de Fonte Global">
                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFonts}" SelectedItem="{x:Bind ViewModel.BuilderModel.Theme.FontFamily, Mode=TwoWay}" Width="200" SelectionChanged="AutoTriggerPreview_Changed" />
                            </settings:SettingsCard>
                            <settings:SettingsCard Header="Fonte Base (pt)">
                                <NumberBox Value="{x:Bind ViewModel.BuilderModel.Theme.BaseFontSize, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="5" Maximum="30" ValueChanged="AutoTriggerPreview_Changed" />
                            </settings:SettingsCard>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Painel 2: Cabeçalho -->
                    <ScrollViewer x:Name="PanelHeader" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Margin="0,0,-12,0" Padding="0,0,12,0">
                        <ScrollViewer.ContentTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </ScrollViewer.ContentTransitions>
                        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch" Padding="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cabeçalho (Header)" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,8" Grid.Column="0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Button Command="{x:Bind ViewModel.UndoCommand}" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Desfazer alteração">
                                        <BitmapIcon UriSource="ms-appx:///Assets/icons8-undo-64.png" Width="20" Height="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ShowAsMonochrome="True" />
                                    </Button>
                                <Button Command="{x:Bind ViewModel.RedoCommand}" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Refazer alteração">
                                        <BitmapIcon UriSource="ms-appx:///Assets/icons8-redo-64.png" Width="20" Height="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ShowAsMonochrome="True" />
                                    </Button>
                            </StackPanel>
                            </Grid>
                            <!-- Nível 1: Etiquetas Horizontais Superiores -->
                            <settings:Segmented SelectionChanged="HeaderPageTab_SelectionChanged" HorizontalAlignment="Stretch" Margin="0,0,0,8" SelectedIndex="0">
                                <settings:SegmentedItem Content="Cabeçalho Principal" />
                                <settings:SegmentedItem Content="Cabeçalho Secundário" />
                            </settings:Segmented>

                            <!-- Nível 2: Filtros por Tema MANTIDOS -->
                            <settings:Segmented x:Name="HeaderSubFilter" SelectionChanged="HeaderFilter_SelectionChanged" HorizontalAlignment="Stretch" Margin="0,0,0,16" SelectedIndex="0">
                                <settings:SegmentedItem Content="Todas" />
                                <settings:SegmentedItem Content="Textos" />
                                <settings:SegmentedItem Content="Logótipo" />
                                <settings:SegmentedItem Content="Layout" />
                            </settings:Segmented>

                            <StackPanel x:Name="ContainerTextos" Spacing="16">
                                <StackPanel.ChildrenTransitions>
                                    <TransitionCollection>
                                        <RepositionThemeTransition />
                                        <EntranceThemeTransition />
                                    </TransitionCollection>
                                </StackPanel.ChildrenTransitions>

                                <!-- Substituímos TextBoxes literais por Styling para o cabeçalho base -->
                                <settings:SettingsExpander Header="Fundo do Cabeçalho" Description="Define a cor de fundo predefinida do cabeçalho">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE790;" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard Header="Cor de Fundo">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Padding="4" Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                    <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Header.HeaderBackgroundColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="8">
                                                                <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Header.HeaderBackgroundColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="AutoTriggerPreview_Changed" />
                                                                <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Header.HeaderBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center" />
                                            </Grid>
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>

                                <settings:SettingsExpander Header="Imagem do Produto no Cabeçalho" Description="Opções de exibição da foto do produto no TDS" IsExpanded="True">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xEB9F;" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard Header="Mostrar Imagem do Produto">
                                            <ToggleSwitch IsOn="{x:Bind ViewModel.BuilderModel.Header.ShowProductImage, Mode=TwoWay}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard Header="Altura Máxima da Imagem (px)">
                                            <NumberBox Value="{x:Bind ViewModel.BuilderModel.Header.ProductImageMaxHeight, Mode=TwoWay}" Minimum="20" Maximum="150" SpinButtonPlacementMode="Inline" SmallChange="5" Width="140" />
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                                
                                <settings:SettingsExpander Header="Estilo do Nome do Produto" Description="Fonte e cor para o Nome principal">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE8D2;" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard Header="Fonte">
                                            <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFonts}" SelectedItem="{x:Bind ViewModel.BuilderModel.Header.TitleFontFamily, Mode=TwoWay}" Width="150" SelectionChanged="AutoTriggerPreview_Changed" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard Header="Cor">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Padding="4" Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                    <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Header.SubtitleColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="8">
                                                                <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Header.SubtitleColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="AutoTriggerPreview_Changed" />
                                                                <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Header.SubtitleColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center" />
                                            </Grid>
                                        </settings:SettingsCard>

                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>

                                <settings:SettingsExpander Header="Estilo da Classificação e Tipo" Description="Fonte e cor para a Categoria, Tipo e Detalhes do Produto">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE8D2;" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard Header="Fonte">
                                            <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFonts}" SelectedItem="{x:Bind ViewModel.BuilderModel.Header.SubtitleFontFamily, Mode=TwoWay}" Width="150" SelectionChanged="AutoTriggerPreview_Changed" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard Header="Cor da Categoria">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Padding="4" Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                    <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Header.TitleColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="8">
                                                                <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Header.TitleColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="AutoTriggerPreview_Changed" />
                                                                <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Header.TitleColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center" />
                                            </Grid>
                                        </settings:SettingsCard>
                                        <settings:SettingsCard Header="Cor da Descrição">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Padding="4" Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                    <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Header.DescriptionColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="8">
                                                                <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Header.DescriptionColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="AutoTriggerPreview_Changed" />
                                                                <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Header.DescriptionColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center" />
                                            </Grid>
                                        </settings:SettingsCard>
                                        <settings:SettingsCard Header="Subtítulo do Documento" Description="O texto principal do documento (ex: Technical Data Sheet).">
                                            <TextBox Text="{x:Bind ViewModel.BuilderModel.Header.DocumentSubtitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="250" TextChanged="AutoTriggerPreview_Changed" PlaceholderText="Deixe em branco para ocultar" />
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                                
                            </StackPanel>

                            <StackPanel x:Name="ContainerLogo" Spacing="16">
                                <StackPanel.ChildrenTransitions>
                                    <TransitionCollection>
                                        <RepositionThemeTransition />
                                        <EntranceThemeTransition />
                                    </TransitionCollection>
                                </StackPanel.ChildrenTransitions>

                                <settings:SettingsExpander Header="Design do Logótipo" Description="Configurar visibilidade, imagem e tamanho do logotipo no cabeçalho" IsExpanded="True">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE114;" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard Header="URL do Ficheiro">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBox Text="{x:Bind ViewModel.BuilderModel.Header.LogoUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="250" />
                                                <Button Content="Procurar" Click="PickLogo_Click" />
                                            </StackPanel>
                                        </settings:SettingsCard>
                                        <settings:SettingsCard Header="Visibilidade">
                                            <CheckBox Content="Mostrar Logótipo no Documento" IsChecked="{x:Bind ViewModel.BuilderModel.Header.ShowLogo, Mode=TwoWay}" Checked="AutoTriggerPreview_Changed" Unchecked="AutoTriggerPreview_Changed" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard Header="Tamanho (px)">
                                            <NumberBox Value="{x:Bind ViewModel.BuilderModel.Header.LogoHeight, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Width="100" ValueChanged="AutoTriggerPreview_Changed" />
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                            </StackPanel>

                            <StackPanel x:Name="ContainerLayout" Spacing="16">
                                <StackPanel.ChildrenTransitions>
                                    <TransitionCollection>
                                        <RepositionThemeTransition />
                                        <EntranceThemeTransition />
                                    </TransitionCollection>
                                </StackPanel.ChildrenTransitions>

                                <settings:SettingsExpander Header="Geometria e Layout" Description="Ajuste de margens e escalas" IsExpanded="True">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE71C;" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard ContentAlignment="Left" Header="Escala &amp; Margens">
                                            <Grid RowSpacing="8" ColumnSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <NumberBox Grid.Row="0" Grid.Column="0" Header="Escala (%)" Value="{x:Bind ViewModel.BuilderModel.Layout.HeaderBaseScalePercentage, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Width="100" ValueChanged="AutoTriggerPreview_Changed" />
                                                <NumberBox Grid.Row="0" Grid.Column="1" Header="Pad Top" Value="{x:Bind ViewModel.BuilderModel.Layout.HeaderPaddingTop, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Width="100" ValueChanged="AutoTriggerPreview_Changed" />
