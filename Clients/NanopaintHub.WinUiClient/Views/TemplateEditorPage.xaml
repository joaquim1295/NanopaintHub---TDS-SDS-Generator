                                        </Grid>
                                    </settings:SettingsCard>
                                </settings:SettingsExpander.Items>
                            </settings:SettingsExpander>



                            <TextBlock Text="Dados e Moradas (Padrão do Template)" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,16,0,8" />
                            
