                                    <FontIcon Glyph="&#xE717;" />
                                </settings:SettingsCard.HeaderIcon>
                                <Button Content="Editar Contactos" Click="OpenContactsDialog_Click">
                                    <Button.ContentTransitions>
                                        <TransitionCollection />
                                    </Button.ContentTransitions>
