<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NanopaintHub_WinUIClient.Views.TemplateEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NanopaintHub_WinUIClient.Models"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto" Padding="0">
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24" VerticalAlignment="Center">
            <Button Command="{x:Bind ViewModel.CancelCommand}" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Voltar">
                <FontIcon Glyph="&#xE72B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
            </Button>
            <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" Margin="0" />
        </StackPanel>

        <!-- Form -->
        <Grid Grid.Row="1">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" Width="64" Height="64" />
            
            <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='negate'}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16" MaxWidth="600" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <TextBox Grid.Column="0" Header="Nome do Template" Text="{x:Bind ViewModel.Template.TemplateName, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="300" />
                    <ComboBox Grid.Column="1" Header="Tipo de Documento" SelectedValue="{x:Bind ViewModel.Template.DocumentType, Mode=TwoWay}" SelectedValuePath="Content" MinWidth="150">
                        <ComboBoxItem Content="TDS" />
                        <ComboBoxItem Content="SDS" />
                    </ComboBox>
                </Grid>
                
                <Pivot Grid.Row="1" SelectionChanged="Pivot_SelectionChanged" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <PivotItem Header="Visual Builder" Margin="0">
                        <NavigationView PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="VisualBuilderNav_SelectionChanged" Background="Transparent" Margin="0,16,0,0">
                            <NavigationView.MenuItems>
                                <NavigationViewItem Content="Definições do Layout" Tag="Settings">
                                    <NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </NavigationViewItem.Icon>
                                </NavigationViewItem>
                                <NavigationViewItem Content="Secções de Conteúdo" Tag="Sections">
                                    <NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE8FD;" />
                                    </NavigationViewItem.Icon>
                                </NavigationViewItem>
                            </NavigationView.MenuItems>
                            
                            <Grid Margin="0,16,0,0">
                                <!-- Aba: DEFINIÇÕES DO LAYOUT -->
                                <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,16" Visibility="Visible">
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="24">
                                        
                                        <!-- Card: Tema Global -->
                                        <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                            <StackPanel Spacing="16">
                                                <TextBlock Text="Tema Global" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                                
                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                                                    
                                                    <!-- Primary Color -->
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
                                                        <TextBlock Text="Cor Primária" Style="{ThemeResource BodyTextBlockStyle}" />
                                                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                                            <Button Grid.Column="0" Width="40" Height="40" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
                                                                <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                                <Button.Flyout>
                                                                    <Flyout>
                                                                        <StackPanel Spacing="8">
                                                                            <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" />
                                                                            <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                                        </StackPanel>
                                                                    </Flyout>
                                                                </Button.Flyout>
                                                            </Button>
                                                            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=TwoWay}" Width="100" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </StackPanel>
                                                    
                                                    <!-- Secondary Color -->
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="8">
                                                        <TextBlock Text="Cor Secundária" Style="{ThemeResource BodyTextBlockStyle}" />
                                                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                                            <Button Grid.Column="0" Width="40" Height="40" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
                                                                <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                                <Button.Flyout>
                                                                    <Flyout>
                                                                        <StackPanel Spacing="8">
                                                                            <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" />
                                                                            <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                                        </StackPanel>
                                                                    </Flyout>
                                                                </Button.Flyout>
                                                            </Button>
                                                            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=TwoWay}" Width="100" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Global Font -->
                                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="8">
                                                        <TextBlock Text="Tipo de Fonte Global" Style="{ThemeResource BodyTextBlockStyle}" />
                                                        <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFonts}" SelectedItem="{x:Bind ViewModel.BuilderModel.Theme.FontFamily, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                                    </StackPanel>

                                                    <!-- Base Font Size and Scale -->
                                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="8">
                                                        <TextBlock Text="Tipografia Base" Style="{ThemeResource BodyTextBlockStyle}" />
                                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                            <NumberBox Grid.Column="0" Header="Fonte (pt)" Value="{x:Bind ViewModel.BuilderModel.Theme.BaseFontSize, Mode=TwoWay}" SpinButtonPlacementMode="Inline" SmallChange="0.5" LargeChange="1" Minimum="5" Maximum="30" HorizontalAlignment="Stretch" />
                                                            <NumberBox Grid.Column="1" Header="Escala Secções (%)" Value="{Binding BuilderModel.Layout.SectionBaseScalePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Inline" SmallChange="5" LargeChange="10" Minimum="50" Maximum="200" HorizontalAlignment="Stretch" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Page Margins -->
                                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="8">
                                                        <TextBlock Text="Margens da Página (mm)" Style="{ThemeResource BodyTextBlockStyle}" />
                                                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                                            <NumberBox Grid.Column="0" Header="T" Value="{x:Bind ViewModel.BuilderModel.Layout.TopMargin, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="100" ToolTipService.ToolTip="Mínimo 12mm c/ cabeçalho" />
                                                            <NumberBox Grid.Column="1" Header="B" Value="{x:Bind ViewModel.BuilderModel.Layout.BottomMargin, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="100" ToolTipService.ToolTip="Mínimo 15mm c/ rodapé" />
                                                            <NumberBox Grid.Column="2" Header="L" Value="{x:Bind ViewModel.BuilderModel.Layout.LeftMargin, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="100" />
                                                            <NumberBox Grid.Column="3" Header="R" Value="{x:Bind ViewModel.BuilderModel.Layout.RightMargin, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="100" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card: Cabeçalho -->
                                        <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                            <StackPanel Spacing="16">
                                                <TextBlock Text="Cabeçalho &amp; Informação" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                                
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="12">
                                                    <StackPanel Grid.Column="0" Spacing="8">
                                                        <TextBox Header="URL do Logotipo" Text="{x:Bind ViewModel.BuilderModel.Header.LogoUrl, Mode=TwoWay}" />
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <Button Grid.Column="0" Content="Procurar Imagem" Click="PickLogo_Click" HorizontalAlignment="Stretch"/>
                                                            <CheckBox Grid.Column="1" Content="Mostrar" IsChecked="{x:Bind ViewModel.BuilderModel.Header.ShowLogo, Mode=TwoWay}" />
                                                        </Grid>
                                                        <NumberBox Header="Altura Logo (px)" Value="{x:Bind ViewModel.BuilderModel.Header.LogoHeight, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1" Spacing="8">
                                                        <TextBox Header="Tipo (ex: TDS)" Text="{x:Bind ViewModel.BuilderModel.Header.InfoDocType, Mode=TwoWay}" />
                                                        <TextBox Header="Subtítulo (ex: Ink)" Text="{x:Bind ViewModel.BuilderModel.Header.InfoCategory, Mode=TwoWay}" />
                                                        <TextBox Header="Versão" Text="{x:Bind ViewModel.BuilderModel.Header.InfoVersion, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Identificação e Espaçamentos" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                    <StackPanel Grid.Column="0" Spacing="8">
                                                        <TextBox Header="Nome Produto (Cabeçalho)" Text="{x:Bind ViewModel.BuilderModel.Header.IdentName, Mode=TwoWay}" />
                                                        <ComboBox Header="Repetir em Páginas Seguintes" ItemsSource="{x:Bind ViewModel.HeaderRepeatStyles}" SelectedItem="{x:Bind ViewModel.BuilderModel.Header.HeaderRepeatStyle, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="8">
                                                        <NumberBox Header="Escala (%)" Value="{Binding BuilderModel.Layout.HeaderBaseScalePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Compact" Minimum="50" Maximum="200" />
                                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                            <NumberBox Grid.Column="0" Header="Pad Top" Value="{x:Bind ViewModel.BuilderModel.Layout.HeaderPaddingTop, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="100" />
                                                            <NumberBox Grid.Column="1" Header="Pad Bot" Value="{x:Bind ViewModel.BuilderModel.Layout.HeaderPaddingBottom, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="100" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card: Rodapé -->
                                        <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                            <StackPanel Spacing="16">
                                                <TextBlock Text="Rodapé &amp; Texto Legal" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                    <TextBox Grid.Column="0" Header="Endereço / Empresa" Text="{x:Bind ViewModel.BuilderModel.Footer.Column1, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" HorizontalAlignment="Stretch" />
                                                    <TextBox Grid.Column="1" Header="Contactos / Website" Text="{x:Bind ViewModel.BuilderModel.Footer.Column2, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" HorizontalAlignment="Stretch" />
                                                </Grid>
                                                <TextBox Header="Trademark / Texto Legal" Text="{x:Bind ViewModel.BuilderModel.Footer.LegalText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" HorizontalAlignment="Stretch" />
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                    <ComboBox Grid.Column="0" Header="Repetição" ItemsSource="{x:Bind ViewModel.FooterRepeatStyles}" SelectedItem="{x:Bind ViewModel.BuilderModel.Footer.FooterRepeatStyle, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                                    <ComboBox Grid.Column="1" Header="Fonte Rodapé" ItemsSource="{x:Bind ViewModel.AvailableFonts}" SelectedItem="{x:Bind ViewModel.BuilderModel.Footer.FontFamily, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Card: Configurações de Espaçamento Extra & Batch -->
                                        <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                            <StackPanel Spacing="16">
                                                <TextBlock Text="Configurações de Lote e Espaços" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                                <CheckBox Content="Mostrar nota de aplicação de lote" IsChecked="{x:Bind ViewModel.BuilderModel.Batch.ShowBatchNote, Mode=TwoWay}" />
                                                <TextBox Header="Formato da Nota de Lote" Text="{x:Bind ViewModel.BuilderModel.Batch.BatchNoteFormat, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.BuilderModel.Batch.ShowBatchNote, Mode=OneWay}" HorizontalAlignment="Stretch" />
                                                
                                                <TextBlock Text="Espaçamentos entre Blocos (mm)" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                    <NumberBox Grid.Column="0" Header="Cabeçalho -> Conteúdo" Value="{x:Bind ViewModel.BuilderModel.Layout.ContentPaddingTop, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                                                    <NumberBox Grid.Column="1" Header="Entre Secções" Value="{x:Bind ViewModel.BuilderModel.Layout.SectionSpacing, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>

                                <!-- Aba: SECÇÕES DE CONTEÚDO -->
                                <ScrollViewer x:Name="SectionsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,16" Visibility="Collapsed">
                                    <ListView ItemsSource="{x:Bind ViewModel.BuilderModel.Sections, Mode=OneWay}"
                                              CanReorderItems="True"
                                              AllowDrop="True"
                                              SelectionMode="None"
                                              IsItemClickEnabled="False">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:TemplateSection">
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.Shadow>
                                                        <ThemeShadow />
                                                    </Grid.Shadow>
                                                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                          CornerRadius="8"
                                                          Translation="0,0,32">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <!-- Left Grabber Handle -->
                                                        <Border Grid.Column="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Width="32" CornerRadius="8,0,0,8">
                                                            <FontIcon Glyph="&#xE76F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="Arraste para reordenar" />
                                                        </Border>

                                                         <StackPanel Grid.Column="1" Spacing="0">
                                                             <Grid Padding="16">
                                                                 <Grid.ColumnDefinitions>
                                                                     <ColumnDefinition Width="*" />
                                                                 </Grid.ColumnDefinitions>
                                                                 <TextBox Text="{x:Bind Title, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="Título da Secção" />
                                                             </Grid>
                                                             
                                                             <Grid Padding="16,0,16,16" Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                 <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24" HorizontalAlignment="Stretch">
                                                                     <!-- Coluna 1: Tipo & Layout -->
                                                                     <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Top">
                                                                         <ComboBox Header="Tipo de Secção" SelectedValue="{x:Bind Type, Mode=TwoWay}" SelectedValuePath="Content" HorizontalAlignment="Stretch">
                                                                             <ComboBoxItem Content="RichText" />
                                                                             <ComboBoxItem Content="Text" />
                                                                             <ComboBoxItem Content="Table" />
                                                                             <ComboBoxItem Content="BulletPoints" />
                                                                             <ComboBoxItem Content="Charts" />
                                                                         </ComboBox>
                                                                         <ComboBox Header="Layout" SelectedValue="{x:Bind IsHalfWidth, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                                                             <ComboBoxItem Content="1 Coluna">
                                                                                 <ComboBoxItem.Tag>
                                                                                     <x:Boolean>False</x:Boolean>
                                                                                 </ComboBoxItem.Tag>
                                                                             </ComboBoxItem>
                                                                             <ComboBoxItem Content="2 Colunas">
                                                                                 <ComboBoxItem.Tag>
                                                                                     <x:Boolean>True</x:Boolean>
                                                                                 </ComboBoxItem.Tag>
                                                                             </ComboBoxItem>
                                                                         </ComboBox>
                                                                         <Button Content="Editar Conteúdo" 
                                                                                 Margin="0,8,0,0"
                                                                                 HorizontalAlignment="Stretch"
                                                                                 Command="{Binding ElementName=RootGrid, Path=DataContext.EditSectionContentCommand}"
                                                                                 CommandParameter="{Binding}"
                                                                                 Visibility="{Binding Type, Converter={StaticResource StringEqualityToVisibilityConverter}, ConverterParameter='RichText'}"
                                                                                 IsEnabled="{Binding ElementName=RootGrid, Path=DataContext.IsNotQuestPdfSelected}"
                                                                                 Style="{ThemeResource AccentButtonStyle}"/>
                                                                     </StackPanel>
                                                                     <!-- Coluna 2: Fonte & Cor -->
                                                                     <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                                                                         <ComboBox Header="Tipo de Fonte" ItemsSource="{Binding ElementName=RootGrid, Path=DataContext.AvailableFonts}" SelectedItem="{x:Bind FontFamily, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                                                         
                                                                         <StackPanel Spacing="4">
                                                                             <TextBlock Text="Cor do Texto" Style="{ThemeResource BodyTextBlockStyle}" />
                                                                             <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                                 <Button Grid.Column="0" Width="36" Height="36" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="18">
                                                                                     <Rectangle Width="26" Height="26" RadiusX="13" RadiusY="13" Fill="{x:Bind TextColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                                                     <Button.Flyout>
                                                                                         <Flyout>
                                                                                             <StackPanel Spacing="8">
                                                                                                 <ColorPicker Color="{x:Bind TextColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" />
                                                                                                 <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                                                             </StackPanel>
                                                                                         </Flyout>
                                                                                     </Button.Flyout>
                                                                                 </Button>
                                                                                 <TextBox Grid.Column="1" Text="{x:Bind TextColor, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                                             </Grid>
                                                                         </StackPanel>
                                                                         <NumberBox Header="Tamanho da Fonte (pt)" Value="{x:Bind FontSize, Mode=TwoWay}" SmallChange="0.5" LargeChange="2" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" PlaceholderText="Padrão (-1)" Margin="0,4,0,0" />
                                                                     </StackPanel>
                                                                     <!-- Coluna 3: Quebras e Spacing -->
                                                                     <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
                                                                         <NumberBox Header="Margem Inferior (px)" Value="{x:Bind MarginBottom, Mode=TwoWay}" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" PlaceholderText="Padrão (-1)" />
                                                                         <NumberBox Header="Altura Mínima (px)" Value="{x:Bind MinHeight, Mode=TwoWay}" SmallChange="10" LargeChange="50" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" PlaceholderText="Nenhuma (0)" />
                                                                         <CheckBox Content="Quebra de Página Antes" IsChecked="{x:Bind PageBreakBefore, Mode=TwoWay}" Margin="0,8,0,0"/>
                                                                     </StackPanel>
                                                                 </Grid>
                                                             </Grid>
                                                         </StackPanel>
                                                        
                                                         <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,12,12,0" Spacing="4">
                                                             <ToggleButton IsChecked="{x:Bind IsExpanded, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Expandir/Recolher Definições">
                                                                 <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                             </ToggleButton>
                                                             <Button Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Remover Secção">
                                                                 <!-- Note: Delete action would be bound here if implemented -->
                                                                 <FontIcon Glyph="&#xE74D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                             </Button>
                                                         </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </ScrollViewer>
                            </Grid>
                        </NavigationView>
                    </PivotItem>
                    
                    <PivotItem Header="HTML Avançado (Under the Hood)" Margin="0" Visibility="{x:Bind ViewModel.IsNotQuestPdfSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="16" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Gerar Layout Padrão" Command="{x:Bind ViewModel.GenerateDefaultTdsLayoutCommand}" Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Height="500">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Estrutura HTML (DOM)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBox Text="{x:Bind ViewModel.Template.HtmlStructure, Mode=TwoWay}" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             FontFamily="Consolas" 
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Folha de Estilos (CSS)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBox Text="{x:Bind ViewModel.Template.CssStructure, Mode=TwoWay}" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             FontFamily="Consolas" 
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </PivotItem>

                </Pivot>
            </Grid>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="16" Margin="0,24,0,0">
            <controls:InfoBar IsOpen="{x:Bind ViewModel.IsQuestPdfSelected, Mode=OneWay}" 
                              Severity="Informational" 
                              Title="Edição indisponível" 
                              Message="A edição HTML livre (via TinyMCE) está desativada porque o motor PDF selecionado (QuestPDF) gera os documentos de forma paramétrica através do Builder." 
                              IsClosable="False" />
            
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Left">
                <Button Content="Salvar Template" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
                <Button Content="Pré-visualizar PDF" Command="{x:Bind ViewModel.GeneratePreviewPdfCommand}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingPreview, Mode=OneWay}" 
                              Visibility="{x:Bind ViewModel.IsLoadingPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              VerticalAlignment="Center" Width="24" Height="24" />
                <Button Content="Preview e Edição Global (TinyMCE)" Command="{x:Bind ViewModel.EditGlobalHtmlCommand}" Visibility="{x:Bind ViewModel.IsNotQuestPdfSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <CheckBox Content="HTML Personalizado Ativo" IsChecked="{x:Bind ViewModel.IsCustomizedHtml, Mode=TwoWay}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsNotQuestPdfSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="Cancelar" Command="{x:Bind ViewModel.CancelCommand}" />
            </StackPanel>
        </StackPanel>
        <!-- Overlay Grid para Preview -->
        <Grid x:Name="PreviewOverlay" Grid.RowSpan="3" Canvas.ZIndex="100" 
              Visibility="{x:Bind ViewModel.IsPdfPreviewVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#CC000000">
            <Grid MaxWidth="900" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="8" Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Overlay Header -->
                <Grid Grid.Row="0" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Pré-visualização do Documento" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Content="Fechar Preview" Command="{x:Bind ViewModel.ClosePreviewCommand}" HorizontalAlignment="Right" Style="{ThemeResource AccentButtonStyle}" />
                </Grid>
                
                <!-- Overlay Content -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#f3f4f6" Padding="24">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PdfPreviewImages, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="24" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" MaxWidth="794" Stretch="Uniform" HorizontalAlignment="Center">
                                    <Image.Shadow>
                                        <ThemeShadow />
                                    </Image.Shadow>
                                </Image>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
