<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NanopaintHub_WinUIClient.Views.TemplateEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NanopaintHub_WinUIClient.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto" Padding="0">
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,24" />

        <!-- Form -->
        <Grid Grid.Row="1">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" Width="64" Height="64" />
            
            <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='negate'}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Spacing="16" MaxWidth="600" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <TextBox Header="Nome do Template" Text="{x:Bind ViewModel.Template.TemplateName, Mode=TwoWay}" />
                    <ComboBox Header="Tipo de Documento" SelectedValue="{x:Bind ViewModel.Template.DocumentType, Mode=TwoWay}" SelectedValuePath="Content">
                        <ComboBoxItem Content="TDS" />
                        <ComboBoxItem Content="SDS" />
                    </ComboBox>
                </StackPanel>
                
                <Pivot Grid.Row="1" SelectionChanged="Pivot_SelectionChanged" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <PivotItem Header="Visual Builder" Margin="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16,16,16">
                            <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">
                                
                                <!-- Cabeçalho -->
                                <Expander Header="Cabeçalho" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
                                            <TextBox Grid.Column="0" Header="URL do Logotipo" Text="{x:Bind ViewModel.BuilderModel.Header.LogoUrl, Mode=TwoWay}" />
                                            <TextBox Grid.Column="1" Header="Altura (px)" Text="{x:Bind ViewModel.BuilderModel.Header.LogoHeight, Mode=TwoWay}" />
                                            <Button Grid.Column="2" Content="..." Click="PickLogo_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                            <CheckBox Grid.Column="3" Content="Mostrar Logo" IsChecked="{x:Bind ViewModel.BuilderModel.Header.ShowLogo, Mode=TwoWay}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                        </Grid>
                                        <ComboBox Header="Estilo em Páginas Seguintes" ItemsSource="{x:Bind ViewModel.HeaderRepeatStyles}" SelectedItem="{x:Bind ViewModel.BuilderModel.Header.HeaderRepeatStyle, Mode=TwoWay}" SelectionChanged="HeaderRepeatStyle_SelectionChanged" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Expander>

                                <!-- Tema -->
                                <Expander Header="Tema Global" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                        
                                        <!-- Primary Color -->
                                        <StackPanel Grid.Column="0" Spacing="8">
                                            <TextBlock Text="Cor Primária" Style="{ThemeResource BodyTextBlockStyle}" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Button Grid.Column="0" Width="40" Height="40" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
                                                    <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="8">
                                                                <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" 
                                                                             IsColorChannelTextInputVisible="True" 
                                                                             IsHexInputVisible="True" 
                                                                             IsAlphaEnabled="False" />
                                                                <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=TwoWay}" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Secondary Color -->
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="Cor Secundária" Style="{ThemeResource BodyTextBlockStyle}" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Button Grid.Column="0" Width="40" Height="40" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
                                                    <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="8">
                                                                <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" 
                                                                             IsColorChannelTextInputVisible="True" 
                                                                             IsHexInputVisible="True" 
                                                                             IsAlphaEnabled="False" />
                                                                <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=TwoWay}" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>

                                    </Grid>
                                </Expander>

                                <!-- Secções -->
                                <Expander Header="Secções de Conteúdo" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.BuilderModel.Sections, Mode=OneWay}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:TemplateSection">
                                                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                      Padding="16" Margin="0,0,0,12" CornerRadius="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="8">
                                                        <TextBox Header="Título da Secção" Text="{x:Bind Title, Mode=TwoWay}" />
                                                        <ComboBox Header="Tipo de Secção" SelectedValue="{x:Bind Type, Mode=TwoWay}" SelectedValuePath="Content">
                                                            <ComboBoxItem Content="RichText" />
                                                            <ComboBoxItem Content="Text" />
                                                            <ComboBoxItem Content="Table" />
                                                            <ComboBoxItem Content="BulletPoints" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Editar Conteúdo no TinyMCE" 
                                                            Style="{ThemeResource AccentButtonStyle}"
                                                            VerticalAlignment="Bottom" Margin="16,0,0,0" 
                                                            Click="EditRichText_Click" 
                                                            Visibility="{x:Bind Type, Converter={StaticResource StringEqualityToVisibilityConverter}, ConverterParameter='RichText', Mode=OneWay}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </Expander>

                                <!-- Rodapé -->
                                <Expander Header="Rodapé" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <TextBox Grid.Column="0" Header="Coluna 1" Text="{x:Bind ViewModel.BuilderModel.Footer.Column1, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
                                            <TextBox Grid.Column="1" Header="Coluna 2" Text="{x:Bind ViewModel.BuilderModel.Footer.Column2, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
                                        </Grid>
                                        <TextBox Header="Texto Legal" Text="{x:Bind ViewModel.BuilderModel.Footer.LegalText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
                                        <ComboBox Header="Estilo em Páginas Seguintes" ItemsSource="{x:Bind ViewModel.FooterRepeatStyles}" SelectedItem="{x:Bind ViewModel.BuilderModel.Footer.FooterRepeatStyle, Mode=TwoWay}" SelectionChanged="FooterRepeatStyle_SelectionChanged" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Expander>
                                
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>
                    
                    <PivotItem Header="HTML Avançado (Under the Hood)" Margin="0">
                        <StackPanel Spacing="16" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Gerar Layout Padrão" Command="{x:Bind ViewModel.GenerateDefaultTdsLayoutCommand}" Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Height="500">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Estrutura HTML (DOM)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBox Text="{x:Bind ViewModel.Template.HtmlStructure, Mode=TwoWay}" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             FontFamily="Consolas" 
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Folha de Estilos (CSS)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBox Text="{x:Bind ViewModel.Template.CssStructure, Mode=TwoWay}" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             FontFamily="Consolas" 
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </PivotItem>
                </Pivot>
            </Grid>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="0,24,0,0" HorizontalAlignment="Left">
            <Button Content="Salvar Template" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
            <Button Content="Preview e Edição Global (TinyMCE)" Click="GlobalTinyMce_Click" />
            <CheckBox Content="HTML Personalizado Ativo" IsChecked="{x:Bind ViewModel.IsCustomizedHtml, Mode=TwoWay}" VerticalAlignment="Center"/>
            <Button Content="Cancelar" Command="{x:Bind ViewModel.CancelCommand}" />
        </StackPanel>
    </Grid>
</Page>
