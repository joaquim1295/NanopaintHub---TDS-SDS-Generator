<Page
    x:Class="NanopaintHub_WinUIClient.Views.TemplateEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NanopaintHub_WinUIClient.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NanopaintHub_WinUIClient.Models"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
    </Page.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*" Padding="0">
        <!-- HEADER (Regra 5: CommandBar Superior) -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{x:Bind ViewModel.CancelCommand}" Background="Transparent" BorderThickness="0" Padding="8" Margin="0,0,16,0" ToolTipService.ToolTip="Voltar" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
            </Button>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox Text="{x:Bind ViewModel.Template.TemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="20" FontWeight="SemiBold" 
                         Background="Transparent" BorderThickness="0" 
                         PlaceholderText="Nome do Template" MinWidth="200" MaxWidth="400" VerticalAlignment="Center" />
                <ComboBox SelectedValue="{x:Bind ViewModel.Template.DocumentType, Mode=TwoWay}" 
                          SelectedValuePath="Content" VerticalAlignment="Center" Width="100" SelectionChanged="DocumentType_SelectionChanged" >
                    <ComboBoxItem Content="TDS" />
                    <ComboBoxItem Content="SDS" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="Cancelar" Command="{x:Bind ViewModel.CancelCommand}" Style="{ThemeResource DefaultButtonStyle}" />
                <Button Content="Salvar Template" Command="{x:Bind ViewModel.SaveCommand}" Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- MAIN LAYOUT (Regra 1: Split-View [Auto] | [6*] | [Auto] | [4*]) -->
        <Grid Grid.Row="1">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" Width="64" Height="64" />
            
            <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='negate'}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Coluna 0: Sidebar Navegação -->
                    <ColumnDefinition Width="2*" />    <!-- Coluna 1: Conteúdo/Editor -->
                    <ColumnDefinition Width="Auto" /> <!-- Coluna 2: Grid Splitter -->
                    <ColumnDefinition Width="3*" x:Name="PreviewColumn" />   <!-- Coluna 3: Live Preview -->
                    <ColumnDefinition Width="Auto" /> <!-- Coluna 4: Preview Sidebar -->
                </Grid.ColumnDefinitions>
                
                <!-- SIDEBAR (Regra 2: Etiquetas Coladas) -->
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Top" Margin="0,16,-1,0" Canvas.ZIndex="1" HorizontalAlignment="Right">
                    <ToggleButton x:Name="TagTheme" IsChecked="True" ToolTipService.ToolTip="Tema Global" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE790;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TagHeader" ToolTipService.ToolTip="Cabeçalho" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE81E;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TagFooter" ToolTipService.ToolTip="Rodapé" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE81D;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TagBatch" ToolTipService.ToolTip="Lotes e Layout" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE8B9;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TagSections" ToolTipService.ToolTip="Secções e Design" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE8FD;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TagCode" ToolTipService.ToolTip="Modo Código Raw" Visibility="{x:Bind ViewModel.IsNotQuestPdfSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Checked="NavigationToggle_Checked" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE943;" />
                    </ToggleButton>
                </StackPanel>
                
                <!-- EDITOR RESPONSIVO (Coluna 1) -->
                <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Canvas.ZIndex="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
                        <controls:InfoBar IsOpen="{x:Bind ViewModel.IsQuestPdfSelected, Mode=OneWay}" 
                                      Severity="Informational" Title="QuestPDF Ativo" 
                                      Message="A edição livre está desativada." 
                                      IsClosable="False" />
                    </StackPanel>
                    
                    
                    <!-- Painel 1: Tema Global -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanelTheme" Visibility="Visible">
                        <ScrollViewer.ContentTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </ScrollViewer.ContentTransitions>
                        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch" Padding="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tema Global" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,8" Grid.Column="0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Button Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="Desfazer alteração" Style="{ThemeResource DefaultButtonStyle}">
                                    <SymbolIcon Symbol="Undo" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="Refazer alteração" Style="{ThemeResource DefaultButtonStyle}">
                                    <SymbolIcon Symbol="Redo" />
                                </Button>
                            </StackPanel>
                            </Grid>
                            
                            <settings:SettingsCard Header="Cor Primária" Description="A cor de destaque do documento.">
                                <settings:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE790;" />
                                </settings:SettingsCard.HeaderIcon>
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <Button Grid.Column="0" Width="40" Height="40" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
                                        <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="8">
                                                    <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="AutoTriggerPreview_Changed" />
                                                    <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center" />
                                </Grid>
                            </settings:SettingsCard>
                            
                            <settings:SettingsCard Header="Cor Secundária" Description="A cor para títulos secundários.">
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <Button Grid.Column="0" Width="40" Height="40" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
                                        <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="8">
                                                    <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="AutoTriggerPreview_Changed" />
                                                    <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center" />
                                </Grid>
                            </settings:SettingsCard>

                            <settings:SettingsCard Header="Tipo de Fonte Global">
                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFonts}" SelectedItem="{x:Bind ViewModel.BuilderModel.Theme.FontFamily, Mode=TwoWay}" Width="200" SelectionChanged="AutoTriggerPreview_Changed" />
                            </settings:SettingsCard>
                            <settings:SettingsCard Header="Fonte Base (pt)">
                                <NumberBox Value="{x:Bind ViewModel.BuilderModel.Theme.BaseFontSize, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="5" Maximum="30" ValueChanged="AutoTriggerPreview_Changed" />
                            </settings:SettingsCard>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Painel 2: Cabeçalho -->
                    <ScrollViewer x:Name="PanelHeader" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <ScrollViewer.ContentTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </ScrollViewer.ContentTransitions>
                        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch" Padding="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cabeçalho (Header)" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,8" Grid.Column="0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Button Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="Desfazer alteração" Style="{ThemeResource DefaultButtonStyle}">
                                    <SymbolIcon Symbol="Undo" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="Refazer alteração" Style="{ThemeResource DefaultButtonStyle}">
                                    <SymbolIcon Symbol="Redo" />
                                </Button>
                            </StackPanel>
                            </Grid>
                            
                            <settings:SettingsCard Header="URL do Logotipo">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Text="{x:Bind ViewModel.BuilderModel.Header.LogoUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                    <Button Content="Procurar" Click="PickLogo_Click" />
                                    <CheckBox Content="Mostrar" IsChecked="{x:Bind ViewModel.BuilderModel.Header.ShowLogo, Mode=TwoWay}" Checked="AutoTriggerPreview_Changed" Unchecked="AutoTriggerPreview_Changed" />
                                </StackPanel>
                            </settings:SettingsCard>
                            
                            <settings:SettingsCard Header="Altura Logo (px)">
                                <NumberBox Value="{x:Bind ViewModel.BuilderModel.Header.LogoHeight, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Width="100" ValueChanged="AutoTriggerPreview_Changed" />
                            </settings:SettingsCard>

                            <settings:SettingsCard Header="Identificação e Subtítulo">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox PlaceholderText="Tipo (ex: TDS)" Text="{x:Bind ViewModel.BuilderModel.Header.InfoDocType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                    <TextBox PlaceholderText="Subtítulo" Text="{x:Bind ViewModel.BuilderModel.Header.InfoCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                </StackPanel>
                            </settings:SettingsCard>
                            
                            <settings:SettingsCard Header="Versão e Revisão">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox PlaceholderText="Versão" Text="{x:Bind ViewModel.BuilderModel.Header.InfoVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    <CalendarDatePicker PlaceholderText="Data de Revisão" Date="{x:Bind ViewModel.BuilderModel.Header.InfoRevisedDate, Mode=TwoWay}" DateChanged="AutoTriggerPreview_Changed" Width="150" />
                                </StackPanel>
                            </settings:SettingsCard>
                            
                            <settings:SettingsCard Header="Nome do Produto">
                                <TextBox Text="{x:Bind ViewModel.BuilderModel.Header.IdentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                            </settings:SettingsCard>
                            
                            <settings:SettingsCard Header="Repetição nas Páginas">
                                <ComboBox ItemsSource="{x:Bind ViewModel.HeaderRepeatStyles}" SelectedItem="{x:Bind ViewModel.BuilderModel.Header.HeaderRepeatStyle, Mode=TwoWay}" Width="200" SelectionChanged="AutoTriggerPreview_Changed" />
                            </settings:SettingsCard>
                            
                            <settings:SettingsCard Header="Escala &amp; Margens">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox Header="Escala (%)" Value="{Binding BuilderModel.Layout.HeaderBaseScalePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Compact" Width="80" ValueChanged="AutoTriggerPreview_Changed" />
                                    <NumberBox Header="Pad Top" Value="{x:Bind ViewModel.BuilderModel.Layout.HeaderPaddingTop, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Width="80" ValueChanged="AutoTriggerPreview_Changed" />
                                    <NumberBox Header="Pad Bot" Value="{x:Bind ViewModel.BuilderModel.Layout.HeaderPaddingBottom, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Width="80" ValueChanged="AutoTriggerPreview_Changed" />
                                </StackPanel>
                            </settings:SettingsCard>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Painel 3: Rodapé -->
                    <ScrollViewer x:Name="PanelFooter" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <ScrollViewer.ContentTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </ScrollViewer.ContentTransitions>
                        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch" Padding="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Rodapé (Footer)" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,8" Grid.Column="0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Button Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="Desfazer alteração" Style="{ThemeResource DefaultButtonStyle}">
                                    <SymbolIcon Symbol="Undo" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="Refazer alteração" Style="{ThemeResource DefaultButtonStyle}">
                                    <SymbolIcon Symbol="Redo" />
                                </Button>
                            </StackPanel>
                            </Grid>
                            <settings:SettingsCard Header="Endereço / Empresa" ContentAlignment="Left">
                                <TextBox Text="{x:Bind ViewModel.BuilderModel.Footer.Column1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Width="400" />
                            </settings:SettingsCard>
                            <settings:SettingsCard Header="Contactos / Website" ContentAlignment="Left">
                                <TextBox Text="{x:Bind ViewModel.BuilderModel.Footer.Column2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Width="400" />
                            </settings:SettingsCard>
                            <settings:SettingsCard Header="Trademark / Texto Legal" ContentAlignment="Left">
                                <TextBox Text="{x:Bind ViewModel.BuilderModel.Footer.LegalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="50" Width="400" />
                            </settings:SettingsCard>
                            <settings:SettingsCard Header="Opções de Rodapé">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0" Header="Repetição" ItemsSource="{x:Bind ViewModel.FooterRepeatStyles}" SelectedItem="{x:Bind ViewModel.BuilderModel.Footer.FooterRepeatStyle, Mode=TwoWay}" Width="150" SelectionChanged="AutoTriggerPreview_Changed" />
                                    <ComboBox Grid.Column="1" Header="Fonte Rodapé" ItemsSource="{x:Bind ViewModel.AvailableFonts}" SelectedItem="{x:Bind ViewModel.BuilderModel.Footer.FontFamily, Mode=TwoWay}" Width="150" SelectionChanged="AutoTriggerPreview_Changed" />
                                </Grid>
                            </settings:SettingsCard>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Painel 4: Margens e Lotes -->
                    <ScrollViewer x:Name="PanelBatch" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <ScrollViewer.ContentTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </ScrollViewer.ContentTransitions>
                        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch" Padding="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Margens e Lotes" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,8" Grid.Column="0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Button Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="Desfazer alteração" Style="{ThemeResource DefaultButtonStyle}">
                                    <SymbolIcon Symbol="Undo" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="Refazer alteração" Style="{ThemeResource DefaultButtonStyle}">
                                    <SymbolIcon Symbol="Redo" />
                                </Button>
                            </StackPanel>
                            </Grid>
                            
                            <settings:SettingsCard Header="Margens da Página (mm)">
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                    <NumberBox Grid.Column="0" Header="Topo (T)" Value="{x:Bind ViewModel.BuilderModel.Layout.TopMargin, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="100" ValueChanged="AutoTriggerPreview_Changed" />
                                    <NumberBox Grid.Column="1" Header="Fundo (B)" Value="{x:Bind ViewModel.BuilderModel.Layout.BottomMargin, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="100" ValueChanged="AutoTriggerPreview_Changed" />
                                    <NumberBox Grid.Column="2" Header="Esq. (L)" Value="{x:Bind ViewModel.BuilderModel.Layout.LeftMargin, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="100" ValueChanged="AutoTriggerPreview_Changed" />
                                    <NumberBox Grid.Column="3" Header="Dir. (R)" Value="{x:Bind ViewModel.BuilderModel.Layout.RightMargin, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="100" ValueChanged="AutoTriggerPreview_Changed" />
                                </Grid>
                            </settings:SettingsCard>
                            
                            <settings:SettingsCard Header="Espaçamentos entre Blocos (mm)">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <NumberBox Grid.Column="0" Header="Cabeçalho -&gt; Conteúdo" Value="{x:Bind ViewModel.BuilderModel.Layout.ContentPaddingTop, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Width="100" ValueChanged="AutoTriggerPreview_Changed" />
                                    <NumberBox Grid.Column="1" Header="Entre Secções" Value="{x:Bind ViewModel.BuilderModel.Layout.SectionSpacing, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Width="100" ValueChanged="AutoTriggerPreview_Changed" />
                                </Grid>
                            </settings:SettingsCard>
                            
                            <settings:SettingsCard Header="Mostrar nota de aplicação de lote">
                                <CheckBox IsChecked="{x:Bind ViewModel.BuilderModel.Batch.ShowBatchNote, Mode=TwoWay}" Checked="AutoTriggerPreview_Changed" Unchecked="AutoTriggerPreview_Changed" />
                            </settings:SettingsCard>
                            <settings:SettingsCard Header="Formato da Nota de Lote">
                                <TextBox Text="{x:Bind ViewModel.BuilderModel.Batch.BatchNoteFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.BuilderModel.Batch.ShowBatchNote, Mode=OneWay}" Width="250" />
                            </settings:SettingsCard>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Painel: Secções de Conteúdo -->
                    <Grid Grid.Row="1" x:Name="PanelSections" Visibility="Collapsed" MaxWidth="1200" HorizontalAlignment="Stretch">
                        <Grid.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </Grid.ChildrenTransitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Spacing="0" Padding="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Secções de Conteúdo" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,16" Grid.Column="0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,16">
                                <Button Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="Desfazer alteração" Style="{ThemeResource DefaultButtonStyle}">
                                    <SymbolIcon Symbol="Undo" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="Refazer alteração" Style="{ThemeResource DefaultButtonStyle}">
                                    <SymbolIcon Symbol="Redo" />
                                </Button>
                            </StackPanel>
                            </Grid>
                            <InfoBar IsOpen="True" Severity="Informational" Title="Design de Elementos GHS" Message="A Ficha de Segurança segue um formato estrito de 16 secções exigido pela regulamentação ECHA/GHS. Pode alterar a cor, tipografia e espaçamentos, mas o seu conteúdo e ordenação estão legalmente bloqueados." Visibility="{x:Bind ViewModel.IsSdsSelected, Mode=OneWay}" Margin="0,0,0,16"/>
                        </StackPanel>
                        
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.BuilderModel.Sections, Mode=OneWay}" DragItemsCompleted="AutoTriggerPreview_Changed"
                                  CanReorderItems="{Binding ElementName=RootGrid, Path=DataContext.IsTdsSelected}"
                                  AllowDrop="True"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  Padding="0,0,16,0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TemplateSection">
                                        <Grid Margin="0,0,0,16">
                                            <Grid.Shadow>
                                                <ThemeShadow />
                                            </Grid.Shadow>
                                            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                  CornerRadius="8"
                                                  Translation="0,0,32">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Left Grabber Handle -->
                                                <Border Grid.Column="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Width="32" CornerRadius="8,0,0,8" Visibility="{Binding ElementName=RootGrid, Path=DataContext.IsTdsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <FontIcon Glyph="&#xE76F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="Arraste para reordenar" />
                                                </Border>
                                                
                                                 <StackPanel Grid.Column="1" Spacing="0">
                                                     <Grid Padding="16">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="*" />
                                                         </Grid.ColumnDefinitions>
                                                         <TextBox Text="{x:Bind Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" PlaceholderText="Título da Secção" IsReadOnly="{Binding ElementName=RootGrid, Path=DataContext.IsSdsSelected}"/>
                                                     </Grid>
                                                     
                                                     <Grid Padding="16,0,16,16" Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                         <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24" HorizontalAlignment="Stretch">
                                                             <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Top" Visibility="{Binding ElementName=RootGrid, Path=DataContext.IsTdsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                 <ComboBox Header="Tipo de Secção" SelectedValue="{x:Bind Type, Mode=TwoWay}" SelectedValuePath="Content" HorizontalAlignment="Stretch"  SelectionChanged="AutoTriggerPreview_Changed" >
                                                                     <ComboBoxItem Content="RichText" />
                                                                     <ComboBoxItem Content="Text" />
                                                                     <ComboBoxItem Content="Table" />
                                                                     <ComboBoxItem Content="BulletPoints" />
                                                                     <ComboBoxItem Content="Charts" />
                                                                     <ComboBoxItem Content="SdsSection1" />
                                                                     <ComboBoxItem Content="SdsSection2" />
                                                                     <ComboBoxItem Content="SdsSection3" />
                                                                     <ComboBoxItem Content="SdsSection9" />
                                                                     <ComboBoxItem Content="SdsSectionText" />
                                                                 </ComboBox>
                                                                 <ComboBox Header="Layout" SelectedValue="{x:Bind IsHalfWidth, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch"  SelectionChanged="AutoTriggerPreview_Changed" >
                                                                     <ComboBoxItem Content="1 Coluna">
                                                                         <ComboBoxItem.Tag>
                                                                             <x:Boolean>False</x:Boolean>
                                                                         </ComboBoxItem.Tag>
                                                                     </ComboBoxItem>
                                                                    <ComboBoxItem Content="2 Colunas">
                                                                         <ComboBoxItem.Tag>
                                                                             <x:Boolean>True</x:Boolean>
                                                                         </ComboBoxItem.Tag>
                                                                     </ComboBoxItem>
                                                                 </ComboBox>
                                                                 <Button Content="Editar Conteúdo" 
                                                                         Margin="0,8,0,0"
                                                                         HorizontalAlignment="Stretch"
                                                                         Command="{Binding ElementName=RootGrid, Path=DataContext.EditSectionContentCommand}"
                                                                         CommandParameter="{Binding}"
                                                                         Visibility="{Binding CanEditContent, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                         IsEnabled="{Binding ElementName=RootGrid, Path=DataContext.IsNotQuestPdfSelected}"
                                                                         Style="{ThemeResource AccentButtonStyle}"/>
                                                                 <InfoBar IsOpen="True" Severity="Informational" 
                                                                          Title="Automático" Message="Gerado dinamicamente via ECHA." 
                                                                          IsClosable="False" Margin="0,8,0,0" 
                                                                          Visibility="{Binding IsDataBound, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                             </StackPanel>
                                                             <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                                                                 <ComboBox Header="Tipo de Fonte" ItemsSource="{Binding ElementName=RootGrid, Path=DataContext.AvailableFonts}" SelectedItem="{x:Bind FontFamily, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="AutoTriggerPreview_Changed" />
                                                                 
                                                                 <StackPanel Spacing="4">
                                                                     <TextBlock Text="Cor do Texto" Style="{ThemeResource BodyTextBlockStyle}" />
                                                                     <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                         <Button Grid.Column="0" Width="36" Height="36" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="18">
                                                                             <Rectangle Width="26" Height="26" RadiusX="13" RadiusY="13" Fill="{x:Bind TextColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                                             <Button.Flyout>
                                                                                 <Flyout>
                                                                                     <StackPanel Spacing="8">
                                                                                         <ColorPicker Color="{x:Bind TextColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="AutoTriggerPreview_Changed" />
                                                                                         <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                                                     </StackPanel>
                                                                                 </Flyout>
                                                                             </Button.Flyout>
                                                                         </Button>
                                                                         <TextBox Grid.Column="1" Text="{x:Bind TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                                     </Grid>
                                                                 </StackPanel>
                                                                 <NumberBox Header="Tamanho da Fonte (pt)" Value="{x:Bind FontSize, Mode=TwoWay}" SmallChange="0.5" LargeChange="2" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" PlaceholderText="Padrão (-1)" Margin="0,4,0,0" ValueChanged="AutoTriggerPreview_Changed" />
                                                             </StackPanel>
                                                             <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
                                                                 <NumberBox Header="Margem Inferior (px)" Value="{x:Bind MarginBottom, Mode=TwoWay}" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" PlaceholderText="Padrão (-1)" ValueChanged="AutoTriggerPreview_Changed" />
                                                                 <NumberBox Header="Altura Mínima (px)" Value="{x:Bind MinHeight, Mode=TwoWay}" SmallChange="10" LargeChange="50" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" PlaceholderText="Nenhuma (0)" ValueChanged="AutoTriggerPreview_Changed" />
                                                                 <CheckBox Content="Quebra de Página Antes" IsChecked="{x:Bind PageBreakBefore, Mode=TwoWay}" Margin="0,8,0,0" Checked="AutoTriggerPreview_Changed" Unchecked="AutoTriggerPreview_Changed" />
                                                             </StackPanel>
                                                         </Grid>
                                                     </Grid>
                                                 </StackPanel>
                                                
                                                 <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,12,12,0" Spacing="4">
                                                     <ToggleButton IsChecked="{x:Bind IsExpanded, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Expandir/Recolher Definições">
                                                         <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                     </ToggleButton>
                                                     <Button Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Remover Secção" Command="{Binding ElementName=RootGrid, Path=DataContext.RemoveSectionCommand}" CommandParameter="{Binding}" Visibility="{Binding ElementName=RootGrid, Path=DataContext.IsTdsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                         <FontIcon Glyph="&#xE74D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                     </Button>
                                                 </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        <Button Grid.Row="2" Content="Adicionar Nova Secção" Command="{x:Bind ViewModel.AddSectionCommand}" Margin="0,16,0,16" Visibility="{x:Bind ViewModel.IsTdsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" MaxWidth="1200" HorizontalAlignment="Stretch"/>
                    </Grid>

                    <!-- Painel: Modo Código HTML/CSS -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanelCode" Visibility="Collapsed">
                        <ScrollViewer.ContentTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </ScrollViewer.ContentTransitions>
                        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch" Padding="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Modo de Edição Manual (HTML/CSS)" Style="{ThemeResource TitleTextBlockStyle}" />
                                <Button Content="Gerar Layout Padrão" Command="{x:Bind ViewModel.GenerateDefaultLayoutCommand}" Style="{ThemeResource AccentButtonStyle}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Height="600" HorizontalAlignment="Stretch">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Estrutura HTML (DOM)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBox Text="{x:Bind ViewModel.Template.HtmlStructure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             FontFamily="Consolas" 
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Folha de Estilos (CSS)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBox Text="{x:Bind ViewModel.Template.CssStructure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             FontFamily="Consolas" 
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- GRID SPLITTER (Coluna 2) -->
                <sizers:GridSplitter x:Name="PreviewSplitter" Grid.Column="2" Width="16" Background="Transparent" ResizeBehavior="BasedOnAlignment" ResizeDirection="Columns" />

                <!-- LIVE PREVIEW ANTI-FLICKERING (Coluna 3) -->
                <Grid x:Name="PreviewContainer" Grid.Column="3" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="16,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Overlay Header -->
                    <Grid Grid.Row="0" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Pré-visualização do Documento" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Content="Atualizar" HorizontalAlignment="Right" Style="{ThemeResource DefaultButtonStyle}" Click="UpdatePreview_Click" ToolTipService.ToolTip="Forçar recarregamento do PDF" />
                    </Grid>
                    
                    <Grid Grid.Row="1">
                        <!-- Content Base -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PdfPreviewImages, Mode=OneWay}" 
                                          Visibility="{x:Bind ViewModel.IsPdfPreviewVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding}" MaxWidth="1000" Stretch="Uniform" Margin="0,8,0,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        
                        <!-- Anti-Flickering Overlay -->
                        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.7" Canvas.ZIndex="50" Visibility="{x:Bind ViewModel.IsLoadingPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingPreview, Mode=OneWay}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- PREVIEW SIDEBAR (Coluna 4: Etiqueta Colada) -->
                <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Top" Margin="-1,16,0,0" Canvas.ZIndex="1" HorizontalAlignment="Left">
                    <ToggleButton x:Name="TogglePreviewBtn" IsChecked="True" ToolTipService.ToolTip="Mostrar Pré-visualização" Checked="TogglePreview_Changed" Unchecked="TogglePreview_Changed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,1,1" CornerRadius="0,8,8,0" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE8A1;" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
