                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Left Grabber Handle (Spans both rows) -->
                                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Width="32" CornerRadius="8,0,0,8" Visibility="{Binding ElementName=RootGrid, Path=DataContext.IsTdsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <FontIcon Glyph="&#xE76F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="Arraste para reordenar" />
                                                </Border>
                                                
                                                <!-- Title TextBox (Row 0, Col 1) -->
                                                <Grid Grid.Row="0" Grid.Column="1" Padding="16">
                                                    <TextBox Text="{x:Bind Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" PlaceholderText="Título da Secção" IsReadOnly="{Binding ElementName=RootGrid, Path=DataContext.IsSdsSelected}"/>
                                                </Grid>
                                                
                                                <!-- Right Icons (Row 0, Col 2) -->
                                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" Spacing="4">
                                                    <ToggleButton IsChecked="{x:Bind IsExpanded, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Expandir/Recolher Definições">
                                                        <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                    </ToggleButton>
                                                    <Button Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Remover Secção" Command="{Binding ElementName=RootGrid, Path=DataContext.RemoveSectionCommand}" CommandParameter="{Binding}" Visibility="{Binding ElementName=RootGrid, Path=DataContext.IsTdsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <FontIcon Glyph="&#xE74D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    </Button>
                                                </StackPanel>

                                                <!-- Expanded Settings (Row 1, Cols 1 & 2) -->
                                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="16,0,16,16" Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Spacing="16">
                                                        <settings:SettingsCard>
                                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                                                <ComboBox Header="Tipo de Secção" SelectedValue="{x:Bind Type, Mode=TwoWay}" SelectedValuePath="Content" Width="200" SelectionChanged="AutoTriggerPreview_Changed" >
                                                                    <ComboBoxItem Content="RichText" />
                                                                    <ComboBoxItem Content="Text" />
                                                                    <ComboBoxItem Content="Table" />
                                                                    <ComboBoxItem Content="BulletPoints" />
                                                                    <ComboBoxItem Content="Charts" />
                                                                    <ComboBoxItem Content="SdsSection1" />
                                                                    <ComboBoxItem Content="SdsSection2" />
                                                                    <ComboBoxItem Content="SdsSection3" />
                                                                    <ComboBoxItem Content="SdsSection9" />
                                                                    <ComboBoxItem Content="SdsSectionText" />
                                                                </ComboBox>
                                                                <ComboBox Header="Layout" SelectedValue="{x:Bind IsHalfWidth, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" SelectionChanged="AutoTriggerPreview_Changed" >
                                                                    <ComboBoxItem Content="1 Coluna">
                                                                        <ComboBoxItem.Tag>
                                                                            <x:Boolean>False</x:Boolean>
                                                                        </ComboBoxItem.Tag>
                                                                    </ComboBoxItem>
                                                                   <ComboBoxItem Content="2 Colunas">
                                                                        <ComboBoxItem.Tag>
                                                                            <x:Boolean>True</x:Boolean>
                                                                        </ComboBoxItem.Tag>
                                                                    </ComboBoxItem>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </settings:SettingsCard>

                                                        <settings:SettingsExpander Header="Tipografia e Cores" Description="Configurações de texto específicas para esta secção">
                                                            <settings:SettingsExpander.HeaderIcon>
                                                                <FontIcon Glyph="&#xE8D2;" />
                                                            </settings:SettingsExpander.HeaderIcon>
                                                            <settings:SettingsExpander.Items>
                                                                <settings:SettingsCard>
                                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                                                        <ComboBox Header="Tipo de Fonte" ItemsSource="{Binding ElementName=RootGrid, Path=DataContext.AvailableFonts}" SelectedItem="{x:Bind FontFamily, Mode=TwoWay}" Width="180" SelectionChanged="AutoTriggerPreview_Changed" />
                                                                        <NumberBox Header="Tamanho (pt)" Value="{x:Bind FontSize, Mode=TwoWay}" SmallChange="0.5" LargeChange="2" SpinButtonPlacementMode="Compact" Width="100" PlaceholderText="Padrão (-1)" ValueChanged="AutoTriggerPreview_Changed" />
                                                                    </StackPanel>
                                                                </settings:SettingsCard>
                                                                
                                                                <settings:SettingsCard Header="Cor do Texto">
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                        <Button Grid.Column="0" Width="36" Height="36" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="18">
                                                                            <Rectangle Width="26" Height="26" RadiusX="13" RadiusY="13" Fill="{x:Bind TextColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                                            <Button.Flyout>
                                                                                <Flyout>
                                                                                    <StackPanel Spacing="8">
                                                                                        <ColorPicker Color="{x:Bind TextColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="AutoTriggerPreview_Changed" />
                                                                                        <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                                                    </StackPanel>
                                                                                </Flyout>
                                                                            </Button.Flyout>
                                                                        </Button>
                                                                        <TextBox Grid.Column="1" Text="{x:Bind TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </settings:SettingsCard>
                                                            </settings:SettingsExpander.Items>
                                                        </settings:SettingsExpander>

                                                        <settings:SettingsExpander Header="Dimensões e Quebras de Página" Description="Regras de espaçamento para a secção">
                                                            <settings:SettingsExpander.HeaderIcon>
                                                                <FontIcon Glyph="&#xE71C;" />
                                                            </settings:SettingsExpander.HeaderIcon>
                                                            <settings:SettingsExpander.Items>
                                                                <settings:SettingsCard>
                                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                                                        <NumberBox Header="Margem Inferior (px)" Value="{x:Bind MarginBottom, Mode=TwoWay}" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" Width="160" PlaceholderText="Padrão (-1)" ValueChanged="AutoTriggerPreview_Changed" />
                                                                        <NumberBox Header="Altura Mínima (px)" Value="{x:Bind MinHeight, Mode=TwoWay}" SmallChange="10" LargeChange="50" SpinButtonPlacementMode="Compact" Width="160" PlaceholderText="Nenhuma (0)" ValueChanged="AutoTriggerPreview_Changed" />
                                                                    </StackPanel>
                                                                </settings:SettingsCard>
                                                                <settings:SettingsCard Header="Forçar Quebra de Página Antes">
                                                                    <ToggleSwitch IsOn="{x:Bind PageBreakBefore, Mode=TwoWay}" Toggled="AutoTriggerPreview_Changed" />
                                                                </settings:SettingsCard>
                                                            </settings:SettingsExpander.Items>
                                                        </settings:SettingsExpander>

                                                        <Button Content="Editar Conteúdo" 
                                                                Margin="0,8,0,0"
                                                                HorizontalAlignment="Stretch"
                                                                Command="{Binding ElementName=RootGrid, Path=DataContext.EditSectionContentCommand}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding CanEditContent, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                IsEnabled="{Binding ElementName=RootGrid, Path=DataContext.IsNotQuestPdfSelected}"
                                                                Style="{ThemeResource AccentButtonStyle}"/>
                                                        <InfoBar IsOpen="True" Severity="Informational" 
                                                                 Title="Automático" Message="Gerado dinamicamente via ECHA." 
                                                                 IsClosable="False" Margin="0,8,0,0" 
                                                                 Visibility="{Binding IsDataBound, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        <Button Grid.Row="2" Content="Adicionar Nova Secção" Command="{x:Bind ViewModel.AddSectionCommand}" Margin="0,16,0,16" Visibility="{x:Bind ViewModel.IsTdsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" MaxWidth="1200" HorizontalAlignment="Stretch"/>
                    </Grid>

                    <!-- Painel: Modo Código HTML/CSS -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanelCode" Visibility="Collapsed">
                        <ScrollViewer.ContentTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </ScrollViewer.ContentTransitions>
                        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch" Padding="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Modo de Edição Manual (HTML/CSS)" Style="{ThemeResource TitleTextBlockStyle}" />
                                <Button Content="Gerar Layout Padrão" Command="{x:Bind ViewModel.GenerateDefaultLayoutCommand}" Style="{ThemeResource AccentButtonStyle}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Height="600" HorizontalAlignment="Stretch">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Estrutura HTML (DOM)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBox Text="{x:Bind ViewModel.Template.HtmlStructure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             FontFamily="Consolas" 
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Folha de Estilos (CSS)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBox Text="{x:Bind ViewModel.Template.CssStructure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             FontFamily="Consolas" 
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- GRID SPLITTER (Coluna 2) -->
                <sizers:GridSplitter x:Name="PreviewSplitter" Grid.Column="2" Width="16" Background="Transparent" ResizeBehavior="BasedOnAlignment" ResizeDirection="Columns" />

                <!-- LIVE PREVIEW ANTI-FLICKERING (Coluna 3) -->
                <Grid x:Name="PreviewContainer" Grid.Column="3" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Overlay Header -->
                    <Grid Grid.Row="0" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Pré-visualização do Documento" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Content="Atualizar" HorizontalAlignment="Right" Style="{ThemeResource DefaultButtonStyle}" Click="UpdatePreview_Click" ToolTipService.ToolTip="Forçar recarregamento do PDF" />
                    </Grid>
                    
                    <Grid Grid.Row="1">
                        <!-- Content Base -->
                        <ScrollViewer x:Name="PreviewScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PdfPreviewImages, Mode=OneWay}" 
                                          Visibility="{x:Bind ViewModel.IsPdfPreviewVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding}" MaxWidth="1000" Stretch="Uniform" Margin="0,8,0,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        
                        <!-- Anti-Flickering Overlay -->
                        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.7" Canvas.ZIndex="50" Visibility="{x:Bind ViewModel.IsLoadingPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingPreview, Mode=OneWay}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- PREVIEW SIDEBAR (Coluna 4: Etiqueta Colada) -->
                <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Top" Margin="-1,16,0,0" Canvas.ZIndex="1" HorizontalAlignment="Left">
                    <ToggleButton x:Name="TogglePreviewBtn" IsChecked="True" ToolTipService.ToolTip="Mostrar Pré-visualização" Checked="TogglePreview_Changed" Unchecked="TogglePreview_Changed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,1,1" CornerRadius="0,8,8,0" Padding="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE8A1;" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Grid>
        <!-- Diálogo para Edição de Endereço -->
        <ContentDialog x:Name="AddressDialog"
                       Title="Editar Endereço da Empresa"
                       PrimaryButtonText="Gravar e Fechar"
                       CloseButtonText="Cancelar"
                       DefaultButton="Primary"
                       CornerRadius="8">
            <Grid Width="500" Margin="0,8,0,0">
                <TextBox x:Name="AddressTextBox" 
                         AcceptsReturn="True" TextWrapping="Wrap" 
                         MinHeight="100" MaxHeight="300" 
                         HorizontalAlignment="Stretch" 
                         PlaceholderText="Ex: Rua da Empresa, 123&#10;Código Postal, Cidade&#10;País" />
            </Grid>
        </ContentDialog>

        <!-- Diálogo para Edição de Contactos -->
        <ContentDialog x:Name="ContactsDialog"
                       Title="Editar Contactos"
                       PrimaryButtonText="Gravar e Fechar"
                       CloseButtonText="Cancelar"
                       DefaultButton="Primary"
                       CornerRadius="8">
            <Grid Width="500" Margin="0,8,0,0">
                <TextBox x:Name="ContactsTextBox" 
                         AcceptsReturn="True" TextWrapping="Wrap" 
                         MinHeight="100" MaxHeight="300" 
                         HorizontalAlignment="Stretch" 
                         PlaceholderText="Ex: Tlf: +351 900 000 000&#10;Email: geral@empresa.com" />
            </Grid>
        </ContentDialog>
        

        <!-- Diálogo para Edição de Texto Legal -->
        <ContentDialog x:Name="LegalTextDialog"
                       Title="Editar Texto Legal do Rodapé"
                       PrimaryButtonText="Gravar e Fechar"
                       CloseButtonText="Cancelar"
                       DefaultButton="Primary"
                       CornerRadius="8">
            <Grid Width="500" Margin="0,8,0,0">
                <TextBox x:Name="LegalTextBox" 
                         AcceptsReturn="True" TextWrapping="Wrap" 
                         MinHeight="150" MaxHeight="400" 
                         HorizontalAlignment="Stretch" 
                         PlaceholderText="Digite o texto de compliance e direitos reservados..." />
            </Grid>
        </ContentDialog>

        <!-- Diálogo para Leitura e Edição das Secções Oficiais SDS -->
        <ContentDialog x:Name="SdsOfficialSectionsDialog"
                       Title="Textos Oficiais (REACH/CLP)"
                       CloseButtonText="Fechar"
                       CornerRadius="8">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">850</x:Double>
            </ContentDialog.Resources>
            <ScrollViewer MaxHeight="540" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{x:Bind ViewModel.SdsOfficialSections, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:SdsOfficialSection">
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" Padding="12">
                                <Expander.Header>
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                                </Expander.Header>
                                <StackPanel Spacing="12" Margin="0,8,0,8" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{x:Bind Content, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Button Click="EditSdsOfficialSection_Click" 
                                            HorizontalAlignment="Right" 
                                            Style="{ThemeResource DefaultButtonStyle}"
                                            ToolTipService.ToolTip="Editar o título e conteúdo desta secção oficial GHS">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                            <TextBlock Text="Editar" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </ContentDialog>

        <!-- Diálogo de Aviso de Riscos de Edição SDS -->
        <ContentDialog x:Name="SdsEditRiskWarningDialog"
                       Title="Aviso Legal de Conformidade (ECHA/GHS)"
                       PrimaryButtonText="Compreendo os Riscos e Desejo Editar"
                       CloseButtonText="Cancelar (Recomendado)"
                       DefaultButton="Close"
                       CornerRadius="8">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">850</x:Double>
            </ContentDialog.Resources>
            <StackPanel HorizontalAlignment="Stretch" Spacing="12" Margin="0,8,0,0">
                <InfoBar IsOpen="True" Severity="Warning" IsClosable="False" Title="Atenção Regulamentar" 
                         Message="Os textos das 16 secções oficiais de uma Ficha de Segurança (SDS) são estritamente regulados pelas normas internacionais REACH (Regulamento CE n.º 1907/2006) e CLP (Regulamento CE n.º 1272/2008)." />
                <TextBlock TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}">
                    A alteração ou omissão não fundamentada do título ou texto de conformidade normativa pode comprometer a validade jurídica do documento e constituir não conformidade legal perante as autoridades competentes.
                </TextBlock>
                <TextBlock x:Name="RiskWarningTargetSectionText" TextWrapping="Wrap" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </ContentDialog>

        <!-- Diálogo para Edição de Título e Texto de Secção SDS -->
        <ContentDialog x:Name="SdsSectionTextEditorDialog"
                       Title="Editar Secção Oficial SDS"
                       PrimaryButtonText="Gravar Alterações"
                       CloseButtonText="Cancelar"
                       DefaultButton="Primary"
                       CornerRadius="8">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">850</x:Double>
            </ContentDialog.Resources>
            <StackPanel HorizontalAlignment="Stretch" Spacing="16" Margin="0,8,0,0">
                <TextBox x:Name="SdsSectionTitleTextBox" 
                         Header="Título da Secção" 
                         HorizontalAlignment="Stretch" 
                         PlaceholderText="Digite o título oficial da secção..." />
                
                <TextBox x:Name="SdsSectionContentTextBox" 
                         Header="Conteúdo da Secção"
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         MinHeight="200" 
                         MaxHeight="400" 
                         HorizontalAlignment="Stretch" 
                         PlaceholderText="Altere o conteúdo textual desta secção oficial..." />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
