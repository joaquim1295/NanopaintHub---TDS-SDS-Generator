<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NanopaintHub_WinUIClient.Views.TemplateEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NanopaintHub_WinUIClient.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto" Padding="0">
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,24" />

        <!-- Form -->
        <Grid Grid.Row="1">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" Width="64" Height="64" />
            
            <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='negate'}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16" MaxWidth="600" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <TextBox Grid.Column="0" Header="Nome do Template" Text="{x:Bind ViewModel.Template.TemplateName, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="300" />
                    <ComboBox Grid.Column="1" Header="Tipo de Documento" SelectedValue="{x:Bind ViewModel.Template.DocumentType, Mode=TwoWay}" SelectedValuePath="Content" MinWidth="150">
                        <ComboBoxItem Content="TDS" />
                        <ComboBoxItem Content="SDS" />
                    </ComboBox>
                </Grid>
                
                <Pivot Grid.Row="1" SelectionChanged="Pivot_SelectionChanged" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <PivotItem Header="Visual Builder" Margin="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16,16,16">
                            
                            <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                                
                                <!-- TOP AREA: 2 COLUMNS ENCAPSULADOS NO EXPANDER DEFINIÇÕES -->
                                <Expander Header="Definições" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    
                                    <!-- COLUNA ESQUERDA -->
                                    <StackPanel Grid.Column="0" Spacing="16">
                                        <!-- Tema Global -->
                                        <Expander Header="Tema Global" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                                                
                                                <!-- Primary Color -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
                                                    <TextBlock Text="Cor Primária" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                                        <Button Grid.Column="0" Width="40" Height="40" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
                                                            <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                            <Button.Flyout>
                                                                <Flyout>
                                                                    <StackPanel Spacing="8">
                                                                        <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" 
                                                                                     IsColorChannelTextInputVisible="True" 
                                                                                     IsHexInputVisible="True" 
                                                                                     IsAlphaEnabled="False" />
                                                                        <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Theme.PrimaryColor, Mode=TwoWay}" Width="100" VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Secondary Color -->
                                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="8">
                                                    <TextBlock Text="Cor Secundária" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                                        <Button Grid.Column="0" Width="40" Height="40" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
                                                            <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                            <Button.Flyout>
                                                                <Flyout>
                                                                    <StackPanel Spacing="8">
                                                                        <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" 
                                                                                     IsColorChannelTextInputVisible="True" 
                                                                                     IsHexInputVisible="True" 
                                                                                     IsAlphaEnabled="False" />
                                                                        <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Theme.SecondaryColor, Mode=TwoWay}" Width="100" VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Global Font -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
                                                    <TextBlock Text="Tipo de Fonte Global" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFonts}" 
                                                              SelectedItem="{x:Bind ViewModel.BuilderModel.Theme.FontFamily, Mode=TwoWay}" 
                                                              Width="250" HorizontalAlignment="Left" />
                                                </StackPanel>

                                                <!-- Base Font Size and Scale -->
                                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                                                    <TextBlock Text="Tipografia Base" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="16">
                                                        <NumberBox Grid.Column="0" Header="Tamanho da Fonte (pt)" Value="{x:Bind ViewModel.BuilderModel.Theme.BaseFontSize, Mode=TwoWay}" 
                                                                   SpinButtonPlacementMode="Inline" SmallChange="0.5" LargeChange="1" 
                                                                   Minimum="5" Maximum="30" Width="120" HorizontalAlignment="Left" />
                                                        <NumberBox Grid.Column="1" Header="Escala das Secções (%)" Value="{Binding BuilderModel.Layout.SectionBaseScalePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                   SpinButtonPlacementMode="Inline" SmallChange="5" LargeChange="10" 
                                                                   Minimum="50" Maximum="200" Width="140" HorizontalAlignment="Left" />
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Content Spacings -->
                                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                                                    <TextBlock Text="Espaçamentos de Conteúdo (mm)" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="16">
                                                        <NumberBox Grid.Column="0" Header="Distância Cabeçalho -> Conteúdo" Value="{x:Bind ViewModel.BuilderModel.Layout.ContentPaddingTop, Mode=TwoWay}" 
                                                                   SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="5" Minimum="0" Maximum="100" Width="200" />
                                                        <NumberBox Grid.Column="1" Header="Distância Lote -> Secções" Value="{x:Bind ViewModel.BuilderModel.Layout.BatchNotePaddingBottom, Mode=TwoWay}" 
                                                                   SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="5" Minimum="0" Maximum="100" Width="180" />
                                                        <NumberBox Grid.Column="2" Header="Espaçamento entre Secções" Value="{x:Bind ViewModel.BuilderModel.Layout.SectionSpacing, Mode=TwoWay}" 
                                                                   SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="5" Minimum="0" Maximum="100" Width="180" />
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Page Margins -->
                                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="8">
                                                    <TextBlock Text="Margens da Página (mm)" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16">
                                                        <NumberBox Grid.Column="0" Header="Topo" Value="{x:Bind ViewModel.BuilderModel.Layout.TopMargin, Mode=TwoWay}" 
                                                                   SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="5" Minimum="0" Maximum="100" Width="100"
                                                                   ToolTipService.ToolTip="Mínimo de 12mm forçado pelo gerador se houver cabeçalho" />
                                                        <NumberBox Grid.Column="1" Header="Fundo" Value="{x:Bind ViewModel.BuilderModel.Layout.BottomMargin, Mode=TwoWay}" 
                                                                   SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="5" Minimum="0" Maximum="100" Width="100"
                                                                   ToolTipService.ToolTip="Mínimo de 15mm forçado pelo gerador se houver rodapé" />
                                                        <NumberBox Grid.Column="2" Header="Esquerda" Value="{x:Bind ViewModel.BuilderModel.Layout.LeftMargin, Mode=TwoWay}" 
                                                                   SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="5" Minimum="0" Maximum="100" Width="100" />
                                                        <NumberBox Grid.Column="3" Header="Direita" Value="{x:Bind ViewModel.BuilderModel.Layout.RightMargin, Mode=TwoWay}" 
                                                                   SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="5" Minimum="0" Maximum="100" Width="100" />
                                                    </Grid>
                                                </StackPanel>

                                            </Grid>
                                        </Expander>

                                        <!-- Cabeçalho -->
                                        <Expander Header="Cabeçalho (Informação &amp; Identificação)" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                <!-- Logo & Repeat Style -->
                                                <StackPanel Grid.Column="0" Spacing="12">
                                                    <TextBlock Text="Logotipo &amp; Geral" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                                        <TextBox Grid.Column="0" Header="URL do Logotipo" Text="{x:Bind ViewModel.BuilderModel.Header.LogoUrl, Mode=TwoWay}" Width="220" />
                                                        <Button Grid.Column="1" Content="..." Click="PickLogo_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                                        <CheckBox Grid.Column="2" Content="Mostrar Logo" IsChecked="{x:Bind ViewModel.BuilderModel.Header.ShowLogo, Mode=TwoWay}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" HorizontalAlignment="Left">
                                                        <TextBox Grid.Column="0" Header="Altura do Logotipo (px)" Text="{x:Bind ViewModel.BuilderModel.Header.LogoHeight, Mode=TwoWay}" Width="120" />
                                                        <NumberBox Grid.Column="1" Header="Escala do Cabeçalho (%)" Value="{Binding BuilderModel.Layout.HeaderBaseScalePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                   SpinButtonPlacementMode="Inline" SmallChange="5" LargeChange="10" Minimum="50" Maximum="200" Width="140" />
                                                        <NumberBox Grid.Column="2" Header="Espaço Topo (mm)" Value="{x:Bind ViewModel.BuilderModel.Layout.HeaderPaddingTop, Mode=TwoWay}" 
                                                                   SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="5" Minimum="0" Maximum="100" Width="140" />
                                                        <NumberBox Grid.Column="3" Header="Espaço Fundo (mm)" Value="{x:Bind ViewModel.BuilderModel.Layout.HeaderPaddingBottom, Mode=TwoWay}" 
                                                                   SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="5" Minimum="0" Maximum="100" Width="140" />
                                                    </Grid>
                                                    <ComboBox Header="Estilo em Páginas Seguintes" ItemsSource="{x:Bind ViewModel.HeaderRepeatStyles}" SelectedItem="{x:Bind ViewModel.BuilderModel.Header.HeaderRepeatStyle, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" />
                                                    
                                                    <TextBlock Text="Informação do Documento" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                                                    <TextBox Header="Tipo de Documento (ex: Technical Data Sheet)" Text="{x:Bind ViewModel.BuilderModel.Header.InfoDocType, Mode=TwoWay}" Width="350" HorizontalAlignment="Left" />
                                                    <TextBox Header="Subtítulo / Categoria (ex: Functional Ink)" Text="{x:Bind ViewModel.BuilderModel.Header.InfoCategory, Mode=TwoWay}" Width="350" HorizontalAlignment="Left" />
                                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="16" HorizontalAlignment="Left">
                                                        <TextBox Grid.Column="0" Header="Versão (ex: Version 3)" Text="{x:Bind ViewModel.BuilderModel.Header.InfoVersion, Mode=TwoWay}" Width="150" />
                                                        <CalendarDatePicker Grid.Column="1" Header="Data de Revisão" Date="{x:Bind ViewModel.BuilderModel.Header.InfoRevisedDate, Mode=TwoWay}" Width="180" HorizontalAlignment="Stretch" />
                                                    </Grid>

                                                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="16" HorizontalAlignment="Left">
                                                        <ComboBox Grid.Column="0" Header="Tipo de Fonte" ItemsSource="{x:Bind ViewModel.AvailableFonts}" SelectedItem="{x:Bind ViewModel.BuilderModel.Header.FontFamily, Mode=TwoWay}" Width="200" />
                                                        
                                                        <!-- TextColor Picker -->
                                                        <StackPanel Grid.Column="1" Spacing="8">
                                                            <TextBlock Text="Cor do Texto" Style="{ThemeResource BodyTextBlockStyle}" />
                                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                                                <Button Grid.Column="0" Width="40" Height="40" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
                                                                    <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Header.TextColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                                    <Button.Flyout>
                                                                        <Flyout>
                                                                            <StackPanel Spacing="8">
                                                                                <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Header.TextColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" />
                                                                                <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                                            </StackPanel>
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Header.TextColor, Mode=TwoWay}" Width="100" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </StackPanel>
                                                        
                                                        <NumberBox Grid.Column="2" Header="Tamanho da Fonte (pt)" Value="{Binding BuilderModel.Header.FontSize, Mode=TwoWay}" SmallChange="1" LargeChange="2" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" PlaceholderText="Padrão (-1)" Width="150" />
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Identification -->
                                                <StackPanel Grid.Column="1" Spacing="12">
                                                    <TextBlock Text="Identificação (Cabeçalho)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                    <TextBox Header="Tipo (ex: Piezoresistive Ink)" Text="{x:Bind ViewModel.BuilderModel.Header.IdentType, Mode=TwoWay}" Width="350" HorizontalAlignment="Left" />
                                                    <TextBox Header="Nome Registado (ex: NP-PI-1000)" Text="{x:Bind ViewModel.BuilderModel.Header.IdentName, Mode=TwoWay}" Width="350" HorizontalAlignment="Left" />
                                                    <TextBox Header="Descrição / Resumo" Text="{x:Bind ViewModel.BuilderModel.Header.IdentDesc, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="140" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Grid>
                                        </Expander>
                                    </StackPanel>

                                    <!-- COLUNA DIREITA -->
                                    <StackPanel Grid.Column="1" Spacing="16">
                                        <!-- Batch (Lote) -->
                                        <Expander Header="Configuração de Lote (Batch)" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="12">
                                                <CheckBox Content="Mostrar nota de aplicação de lote (Se houver)" IsChecked="{x:Bind ViewModel.BuilderModel.Batch.ShowBatchNote, Mode=TwoWay}" />
                                                <TextBox Header="Formato da Nota" Text="{x:Bind ViewModel.BuilderModel.Batch.BatchNoteFormat, Mode=TwoWay}" 
                                                         PlaceholderText="Ex: Batch data applied: {batch} (merged with product specifications where applicable)."
                                                         IsEnabled="{x:Bind ViewModel.BuilderModel.Batch.ShowBatchNote, Mode=OneWay}"
                                                         MaxWidth="500" HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                        </Expander>

                                        <!-- Rodapé -->
                                        <Expander Header="Rodapé" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                    <StackPanel Grid.Column="0" Spacing="8">
                                                        <TextBlock Text="Endereço / Empresa (Coluna 1)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                        <TextBox Text="{x:Bind ViewModel.BuilderModel.Footer.Column1, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" HorizontalAlignment="Stretch" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="8">
                                                        <TextBlock Text="Contactos / Website (Coluna 2)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                        <TextBox Text="{x:Bind ViewModel.BuilderModel.Footer.Column2, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" HorizontalAlignment="Stretch" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBox Header="Trademark / Direitos e Avisos (Texto Legal)" Text="{x:Bind ViewModel.BuilderModel.Footer.LegalText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" HorizontalAlignment="Stretch" />
                                                <ComboBox Header="Estilo em Páginas Seguintes" ItemsSource="{x:Bind ViewModel.FooterRepeatStyles}" SelectedItem="{x:Bind ViewModel.BuilderModel.Footer.FooterRepeatStyle, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" />
                                                
                                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="16" HorizontalAlignment="Left">
                                                    <ComboBox Grid.Column="0" Header="Tipo de Fonte" ItemsSource="{x:Bind ViewModel.AvailableFonts}" SelectedItem="{x:Bind ViewModel.BuilderModel.Footer.FontFamily, Mode=TwoWay}" Width="200" />
                                                    
                                                    <!-- TextColor Picker -->
                                                    <StackPanel Grid.Column="1" Spacing="8">
                                                        <TextBlock Text="Cor do Texto" Style="{ThemeResource BodyTextBlockStyle}" />
                                                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                                            <Button Grid.Column="0" Width="40" Height="40" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20">
                                                                <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Footer.TextColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                                <Button.Flyout>
                                                                    <Flyout>
                                                                        <StackPanel Spacing="8">
                                                                            <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Footer.TextColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" />
                                                                            <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                                        </StackPanel>
                                                                    </Flyout>
                                                                </Button.Flyout>
                                                            </Button>
                                                            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Footer.TextColor, Mode=TwoWay}" Width="100" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>

                                    </Grid>
                                </Expander>

                                <!-- BOTTOM AREA: SECÇÕES (1 COLUMN) -->
                                <Expander Header="Secções de Conteúdo" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <ListView ItemsSource="{x:Bind ViewModel.BuilderModel.Sections, Mode=OneWay}"
                                              CanReorderItems="True"
                                              AllowDrop="True"
                                              SelectionMode="None"
                                              IsItemClickEnabled="False">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:TemplateSection">
                                                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                      Padding="16" Margin="0,0,0,12" CornerRadius="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                     <StackPanel Grid.Column="0" Spacing="16">
                                                         <TextBox Header="Título da Secção" Text="{x:Bind Title, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                                         
                                                         <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24" HorizontalAlignment="Stretch">
                                                             <!-- Coluna 1: Tipo & Layout -->
                                                             <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Top">
                                                                 <ComboBox Header="Tipo de Secção" SelectedValue="{x:Bind Type, Mode=TwoWay}" SelectedValuePath="Content" HorizontalAlignment="Stretch">
                                                                     <ComboBoxItem Content="RichText" />
                                                                     <ComboBoxItem Content="Text" />
                                                                     <ComboBoxItem Content="Table" />
                                                                     <ComboBoxItem Content="BulletPoints" />
                                                                     <ComboBoxItem Content="Charts" />
                                                                 </ComboBox>
                                                                 <ComboBox Header="Layout" SelectedValue="{x:Bind IsHalfWidth, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                                                     <ComboBoxItem Content="1 Coluna">
                                                                         <ComboBoxItem.Tag>
                                                                             <x:Boolean>False</x:Boolean>
                                                                         </ComboBoxItem.Tag>
                                                                     </ComboBoxItem>
                                                                     <ComboBoxItem Content="2 Colunas">
                                                                         <ComboBoxItem.Tag>
                                                                             <x:Boolean>True</x:Boolean>
                                                                         </ComboBoxItem.Tag>
                                                                     </ComboBoxItem>
                                                                 </ComboBox>
                                                                 <Button Content="Editar Conteúdo" 
                                                                         Margin="0,8,0,0"
                                                                         HorizontalAlignment="Stretch"
                                                                         Command="{Binding ElementName=RootGrid, Path=DataContext.EditSectionContentCommand}"
                                                                         CommandParameter="{Binding}"
                                                                         Visibility="{Binding Type, Converter={StaticResource StringEqualityToVisibilityConverter}, ConverterParameter='RichText'}"
                                                                         Style="{ThemeResource AccentButtonStyle}"/>
                                                             </StackPanel>

                                                             <!-- Coluna 2: Fonte & Cor -->
                                                             <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                                                                 <ComboBox Header="Tipo de Fonte" ItemsSource="{Binding ElementName=RootGrid, Path=DataContext.AvailableFonts}" SelectedItem="{x:Bind FontFamily, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                                                 
                                                                 <StackPanel Spacing="4">
                                                                     <TextBlock Text="Cor do Texto" Style="{ThemeResource BodyTextBlockStyle}" />
                                                                     <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                         <Button Grid.Column="0" Width="36" Height="36" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="18">
                                                                             <Rectangle Width="26" Height="26" RadiusX="13" RadiusY="13" Fill="{x:Bind TextColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                                             <Button.Flyout>
                                                                                 <Flyout>
                                                                                     <StackPanel Spacing="8">
                                                                                         <ColorPicker Color="{x:Bind TextColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" />
                                                                                         <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                                                     </StackPanel>
                                                                                 </Flyout>
                                                                             </Button.Flyout>
                                                                         </Button>
                                                                         <TextBox Grid.Column="1" Text="{x:Bind TextColor, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                                     </Grid>
                                                                 </StackPanel>
                                                                 <NumberBox Header="Tamanho da Fonte (pt)" Value="{x:Bind FontSize, Mode=TwoWay}" SmallChange="0.5" LargeChange="2" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" PlaceholderText="Padrão (-1)" Margin="0,4,0,0" />
                                                             </StackPanel>

                                                             <!-- Coluna 3: Quebras e Spacing -->
                                                             <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
                                                                 <NumberBox Header="Margem Inferior (px)" Value="{x:Bind MarginBottom, Mode=TwoWay}" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" PlaceholderText="Padrão (-1)" />
                                                                 <NumberBox Header="Altura Mínima (px)" Value="{x:Bind MinHeight, Mode=TwoWay}" SmallChange="10" LargeChange="50" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" PlaceholderText="Nenhuma (0)" />
                                                                 <CheckBox Content="Quebra de Página Antes" IsChecked="{x:Bind PageBreakBefore, Mode=TwoWay}" Margin="0,8,0,0"/>
                                                             </StackPanel>
                                                         </Grid>
                                                     </StackPanel>
                                                    <!-- Reorder Icon -->
                                                    <FontIcon Grid.Column="1" Glyph="&#xE700;" FontFamily="{ThemeResource SymbolThemeFontFamily}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,0,0,0" ToolTipService.ToolTip="Arraste para reordenar" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>
                    
                    <PivotItem Header="HTML Avançado (Under the Hood)" Margin="0">
                        <StackPanel Spacing="16" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Gerar Layout Padrão" Command="{x:Bind ViewModel.GenerateDefaultTdsLayoutCommand}" Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Height="500">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Estrutura HTML (DOM)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBox Text="{x:Bind ViewModel.Template.HtmlStructure, Mode=TwoWay}" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             FontFamily="Consolas" 
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Folha de Estilos (CSS)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBox Text="{x:Bind ViewModel.Template.CssStructure, Mode=TwoWay}" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             FontFamily="Consolas" 
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </PivotItem>
                </Pivot>
            </Grid>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="0,24,0,0" HorizontalAlignment="Left">
            <Button Content="Salvar Template" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
            <Button Content="Preview e Edição Global (TinyMCE)" Command="{x:Bind ViewModel.EditGlobalHtmlCommand}" />
            <CheckBox Content="HTML Personalizado Ativo" IsChecked="{x:Bind ViewModel.IsCustomizedHtml, Mode=TwoWay}" VerticalAlignment="Center"/>
            <Button Content="Cancelar" Command="{x:Bind ViewModel.CancelCommand}" />
        </StackPanel>
    </Grid>
</Page>
