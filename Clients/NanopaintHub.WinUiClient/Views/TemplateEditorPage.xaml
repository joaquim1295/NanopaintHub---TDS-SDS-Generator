<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NanopaintHub_WinUIClient.Views.TemplateEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,24" />

        <!-- Form -->
        <Grid Grid.Row="1">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" Width="64" Height="64" />
            
            <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='negate'}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Spacing="16" MaxWidth="600" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <TextBox Header="Nome do Template" Text="{x:Bind ViewModel.Template.TemplateName, Mode=TwoWay}" />
                    <ComboBox Header="Tipo de Documento" SelectedValue="{x:Bind ViewModel.Template.DocumentType, Mode=TwoWay}" SelectedValuePath="Content">
                        <ComboBoxItem Content="TDS" />
                        <ComboBoxItem Content="SDS" />
                    </ComboBox>
                </StackPanel>
                
                <TextBox Grid.Row="1" Header="Conteúdo HTML (Avançado)" 
                         Text="{x:Bind ViewModel.Template.HtmlStructure, Mode=TwoWay}" 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         FontFamily="Consolas" 
                         HorizontalAlignment="Stretch" 
                         VerticalAlignment="Stretch" />
            </Grid>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="0,24,0,0" HorizontalAlignment="Left">
            <Button Content="Salvar" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
            <Button Content="Cancelar" Command="{x:Bind ViewModel.CancelCommand}" />
        </StackPanel>
    </Grid>
</Page>
