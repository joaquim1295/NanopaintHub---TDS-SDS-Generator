                                                <Rectangle Width="30" Height="30" RadiusX="15" RadiusY="15" Fill="{x:Bind ViewModel.BuilderModel.Theme.BodyTextColor, Mode=OneWay, Converter={StaticResource StringToSolidColorBrushConverter}}" />
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <StackPanel Spacing="8">
                                                            <ColorPicker Color="{x:Bind ViewModel.BuilderModel.Theme.BodyTextColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="AutoTriggerPreview_Changed" />
                                                            <Button Content="Fechar" HorizontalAlignment="Right" Click="CloseColorFlyout_Click" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.BuilderModel.Theme.BodyTextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center" />
                                        </Grid>
                                    </settings:SettingsCard>

                                    <settings:SettingsCard Header="Fonte dos Títulos">
                                        <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFonts}" SelectedItem="{x:Bind ViewModel.BuilderModel.Theme.TitleFontFamily, Mode=TwoWay}" Width="200" SelectionChanged="AutoTriggerPreview_Changed" />
                                    </settings:SettingsCard>

                                    <settings:SettingsCard Header="Fonte do Texto do Conteúdo">
                                        <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFonts}" SelectedItem="{x:Bind ViewModel.BuilderModel.Theme.FontFamily, Mode=TwoWay}" Width="200" SelectionChanged="AutoTriggerPreview_Changed" />
                                    </settings:SettingsCard>

                                    <settings:SettingsCard Header="Espaçamento Título -&gt; Conteúdo (px)">
                                        <NumberBox Value="{x:Bind ViewModel.BuilderModel.Layout.TitleBottomSpacing, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="50" ValueChanged="AutoTriggerPreview_Changed" Width="120" />
                                    </settings:SettingsCard>

                                    <settings:SettingsCard Header="Espaçamento entre Secções">
                                        <NumberBox Value="{x:Bind ViewModel.BuilderModel.Layout.SectionSpacing, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="100" ValueChanged="AutoTriggerPreview_Changed" Width="120" />
                                    </settings:SettingsCard>
                                </settings:SettingsExpander.Items>
                            </settings:SettingsExpander>
                        </StackPanel>
                        
