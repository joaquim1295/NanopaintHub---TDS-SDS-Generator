                            <!-- Estilo e Formatação Global das Secções -->
                            <settings:SettingsExpander Header="Estilo e Formatação Global das Secções" Description="Personalize a cor, fonte e espaçamentos aplicados a todas as secções" IsExpanded="True" Margin="0,0,0,16">
